<UserControl
    x:Class="Vaz.WinUI.Views.ModrinthStyleBrowserView"
    x:Name="ModrinthBrowserRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Vaz.WinUI.ViewModels"
    xmlns:views="using:Vaz.WinUI.Views"
    KeyDown="UserControl_KeyDown"
    PreviewKeyDown="UserControl_PreviewKeyDown">

    <UserControl.Resources>
        <Storyboard x:Name="ShimmerStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="ShimmerPanel"
                Storyboard.TargetProperty="Opacity"
                From="0.3" To="0.8" Duration="0:0:0.75" />
        </Storyboard>
        <Storyboard x:Name="FadeInResultsStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="ResultsGridView"
                Storyboard.TargetProperty="Opacity"
                From="0.0" To="1.0" Duration="0:0:0.25" />
        </Storyboard>
    </UserControl.Resources>

    <Grid Background="#121316">
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 0. Header Bar -->
        <Border
            Grid.Row="0"
            Background="#181a1f"
            BorderBrush="#2a2e38"
            BorderThickness="0,0,0,1"
            Padding="20,12">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <!-- Left: Back Button & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button
                        Click="Back_Click"
                        ToolTipService.ToolTip="Quay lại (Esc)"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        CornerRadius="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="16" Foreground="#c9d1d9" />
                    </Button>

                    <Border
                        Background="#1b3826"
                        BorderBrush="#1bd96a"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,3"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE71E;" FontSize="12" Foreground="#1bd96a" />
                            <TextBlock
                                Text="Modrinth"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#1bd96a" />
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Text="{x:Bind ViewModel.BrowserTitle, Mode=OneWay}"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#ffffff"
                        VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center: Large Search Bar -->
                <Grid Grid.Column="1" Margin="24,0,24,0" MaxWidth="540" HorizontalAlignment="Stretch">
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}"
                        QueryIcon="Find"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                        PreviewKeyDown="SearchBox_PreviewKeyDown"
                        TextChanged="SearchBox_TextChanged"
                        QuerySubmitted="SearchBox_QuerySubmitted"
                        HorizontalAlignment="Stretch" />
                </Grid>

                <!-- Right: Sort Dropdown -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Sắp xếp:" Foreground="#8b949e" FontSize="13" VerticalAlignment="Center" />
                    <ComboBox
                        ItemsSource="{x:Bind ViewModel.SortOptions}"
                        SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}"
                        MinWidth="130" />
                </StackPanel>

                <!-- Close Button -->
                <Button
                    Grid.Column="3"
                    Click="Close_Click"
                    ToolTipService.ToolTip="Đóng trình duyệt (Esc)"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8"
                    CornerRadius="6">
                    <FontIcon Glyph="&#xE711;" FontSize="15" Foreground="#8b949e" />
                </Button>
            </Grid>
        </Border>

        <!-- 1. Main Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR (270px Filters) -->
            <Border
                Grid.Column="0"
                Background="#16181d"
                BorderBrush="#242831"
                BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Sidebar Header -->
                    <Border Grid.Row="0" Padding="16,14" BorderBrush="#242831" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE71C;" FontSize="15" Foreground="#1bd96a" />
                            <TextBlock Text="Bộ lọc (Filters)" FontSize="15" FontWeight="SemiBold" Foreground="#ffffff" />
                        </StackPanel>
                    </Border>

                    <!-- Scrollable Filters -->
                    <ScrollViewer Grid.Row="1" Padding="14,10" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <!-- Project Type Expander -->
                            <Expander Header="Loại dự án" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="6" Margin="0,4,0,4">
                                    <RadioButton
                                        Content="Resource Packs"
                                        IsChecked="{x:Bind ViewModel.IsResourcePacks, Mode=TwoWay}"
                                        Foreground="#c9d1d9" />
                                    <RadioButton
                                        Content="Shaders"
                                        IsChecked="{x:Bind ViewModel.IsShaders, Mode=TwoWay}"
                                        Foreground="#c9d1d9" />
                                </StackPanel>
                            </Expander>

                            <!-- Game Version Expander -->
                            <Expander Header="Phiên bản Game" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <ComboBox
                                    ItemsSource="{x:Bind ViewModel.VersionOptions}"
                                    SelectedItem="{x:Bind ViewModel.SelectedGameVersion, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,4" />
                            </Expander>

                            <!-- Categories Expander -->
                            <Expander Header="Thể loại (Categories)" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.CategoryFilters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FilterCheckboxItem">
                                            <CheckBox
                                                Content="{x:Bind DisplayName}"
                                                IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                                Foreground="#c9d1d9"
                                                Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>

                            <!-- Loaders Expander -->
                            <Expander Header="Mod Loader" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.LoaderFilters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FilterCheckboxItem">
                                            <CheckBox
                                                Content="{x:Bind DisplayName}"
                                                IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                                Foreground="#c9d1d9"
                                                Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>

                            <!-- Environment Expander -->
                            <Expander Header="Môi trường (Environment)" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.EnvironmentFilters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FilterCheckboxItem">
                                            <CheckBox
                                                Content="{x:Bind DisplayName}"
                                                IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                                Foreground="#c9d1d9"
                                                Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Clear Filters Button -->
                    <Border Grid.Row="2" Padding="14,12" BorderBrush="#242831" BorderThickness="0,1,0,0">
                        <Button
                            Command="{x:Bind ViewModel.ClearFiltersCommand}"
                            HorizontalAlignment="Stretch"
                            Background="#1f232b"
                            BorderBrush="#30363d"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="0,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                <FontIcon Glyph="&#xE894;" FontSize="13" Foreground="#8b949e" />
                                <TextBlock Text="Xóa bộ lọc (Clear)" FontSize="13" Foreground="#c9d1d9" />
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT: Main Workspace Content -->
            <Grid Grid.Column="1" Padding="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Status Header -->
            <Grid Grid.Row="0" Margin="4,0,4,12" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                        FontSize="13"
                        Foreground="#8b949e"
                        VerticalAlignment="Center" />
                    <ProgressRing
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Width="14"
                        Height="14"
                        Foreground="#1bd96a"
                        VerticalAlignment="Center"
                        Margin="4,0,0,0" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Click="LoadPrevious_Click"
                    Background="#1f232b"
                    BorderBrush="#1bd96a"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8,3">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE70E;" FontSize="11" Foreground="#1bd96a" />
                        <TextBlock Text="Tải mục trước" FontSize="11" Foreground="#1bd96a" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Grid Results -->
            <GridView
                Grid.Row="1"
                x:Name="ResultsGridView"
                ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                ContainerContentChanging="ResultsGridView_ContainerContentChanging"
                Loaded="ResultsGridView_Loaded"
                SelectionMode="None"
                IsItemClickEnabled="False"
                Padding="0,0,0,16">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="290" ItemHeight="310" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerTransitions>
                    <TransitionCollection />
                </GridView.ItemContainerTransitions>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SearchHitRow">
                        <views:ModrinthCardView
                            Item="{x:Bind}"
                            InstallClick="ModrinthCard_InstallClick"
                            Margin="6" />
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <Grid x:Name="ShimmerPanel" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
