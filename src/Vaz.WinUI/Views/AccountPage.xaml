<Page
    x:Class="Vaz.WinUI.Views.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Vaz.WinUI.ViewModels"
    NavigationCacheMode="Required">

    <Grid Padding="16,12,16,12" RowSpacing="8" RowDefinitions="Auto,Auto,*,Auto">
        <!-- Header -->
        <StackPanel>
            <TextBlock Text="Tài khoản" FontSize="22" FontWeight="SemiBold" />
            <TextBlock
                Text="Cần ít nhất 1 tài khoản active để Launch instance."
                Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>

        <!-- Toolbar -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8">
            <Button Grid.Column="0" Content="Add Offline" Click="AddOffline_Click" />
            <Button Grid.Column="1" Content="Add Microsoft" Click="AddMicrosoft_Click" />
            <Button Grid.Column="2" Content="Refresh (active)" Click="RefreshActive_Click" />
            <Button Grid.Column="3" Content="Tải lại danh sách" Click="Reload_Click" />
        </Grid>

        <!-- Danh sách tài khoản -->
        <ListView
            Grid.Row="2"
            x:Name="AccountsList"
            ItemsSource="{x:Bind ViewModel.Accounts, Mode=OneWay}"
            SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:AccountRow">
                    <Grid Padding="4,6" ColumnDefinitions="40,*,Auto,Auto" ColumnSpacing="8">
                        <!-- Avatar placeholder -->
                        <FontIcon Glyph="&#xE77B;" FontSize="24" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="4"
                                    Padding="6,1">
                                    <TextBlock Text="{x:Bind KindText}" Style="{StaticResource CaptionTextBlockStyle}" />
                                </Border>
                                <TextBlock
                                    Text="✓ Active"
                                    Foreground="Green"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            Content="Set active"
                            VerticalAlignment="Center"
                            Click="SetActive_Click" />
                        <Button
                            Grid.Column="3"
                            Content="Xóa"
                            VerticalAlignment="Center"
                            Click="Remove_Click" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Status / Error -->
        <StackPanel Grid.Row="3" Spacing="4">
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=TwoWay}"
                Severity="Error"
                Title="Lỗi"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            <TextBlock
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap" />
            <ProgressRing
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Width="20"
                Height="20" />
        </StackPanel>
    </Grid>
</Page>
