<Page
    x:Class="Vaz.WinUI.Views.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Vaz.WinUI.ViewModels"
    NavigationCacheMode="Required">

    <Grid Padding="24" RowSpacing="16" RowDefinitions="Auto,Auto,*,Auto">
        <!-- Header -->
        <StackPanel Spacing="4">
            <TextBlock Text="Tài khoản" FontSize="28" FontWeight="SemiBold" />
            <TextBlock
                Text="Cần ít nhất 1 tài khoản active để Launch instance."
                Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <Button Content="Add Offline" Click="AddOffline_Click" />
            <Button Content="Add Microsoft" Click="AddMicrosoft_Click" />
            <Button Content="Refresh (active)" Click="RefreshActive_Click" />
            <Button Content="Tải lại danh sách" Click="Reload_Click" />
        </StackPanel>

        <!-- Danh sách tài khoản -->
        <ListView
            Grid.Row="2"
            x:Name="AccountsList"
            ItemsSource="{x:Bind ViewModel.Accounts, Mode=OneWay}"
            SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,4" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:AccountRow">
                    <Border
                        Padding="14,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid ColumnDefinitions="48,*,Auto,Auto" ColumnSpacing="16">
                            <!-- Minecraft Avatar -->
                            <Border
                                Width="48"
                                Height="48"
                                CornerRadius="6"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <Image
                                    Width="48"
                                    Height="48"
                                    Stretch="UniformToFill">
                                    <Image.Source>
                                        <BitmapImage UriSource="{x:Bind AvatarUri}" />
                                    </Image.Source>
                                </Image>
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="15" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        CornerRadius="4"
                                        Padding="6,2">
                                        <TextBlock Text="{x:Bind KindText}" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Border>
                                    <TextBlock
                                        Text="✓ Active"
                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                        FontWeight="Medium"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </StackPanel>

                            <Button
                                Grid.Column="2"
                                Content="Set active"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                Click="SetActive_Click" />
                            <Button
                                Grid.Column="3"
                                Content="Xóa"
                                VerticalAlignment="Center"
                                Click="Remove_Click" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Status / Error -->
        <StackPanel Grid.Row="3" Spacing="4">
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=TwoWay}"
                Severity="Error"
                Title="Lỗi"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            <TextBlock
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap" />
            <ProgressRing
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Width="20"
                Height="20" />
        </StackPanel>
    </Grid>
</Page>
