<Page
    x:Class="Vaz.WinUI.Views.InstancesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Vaz.WinUI.ViewModels">

    <Grid RowDefinitions="Auto,*" Padding="24" RowSpacing="16">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Text="Instances" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Click="NewInstance_Click" ToolTipService.ToolTip="New Instance">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Add" />
                    <TextBlock Text="New" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Empty state -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.HasNoInstances, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <FontIcon Glyph="&#xE7F8;" FontSize="48" Opacity="0.4" />
            <TextBlock Text="Chưa có instance nào." HorizontalAlignment="Center" Opacity="0.6" />
            <TextBlock Text="Bấm + để tạo instance mới." HorizontalAlignment="Center" Opacity="0.4" />
        </StackPanel>

        <!-- Instance grid -->
        <GridView
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Instances}"
            IsItemClickEnabled="True"
            ItemClick="Instance_Click"
            Visibility="{x:Bind ViewModel.HasInstances, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:InstanceCardItem">
                    <Border
                        Width="220" MinHeight="130"
                        Padding="12"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <Border.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Play" Tag="{x:Bind Id}" Click="ContextPlay_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE768;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Edit" Tag="{x:Bind Id}" Click="ContextEdit_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE713;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Open folder" Tag="{x:Bind Id}" Click="ContextOpenFolder_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE838;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Delete" Tag="{x:Bind Id}" Click="ContextDelete_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Border.ContextFlyout>
                        <Grid RowDefinitions="*,Auto" RowSpacing="8">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    Text="{x:Bind Name}"
                                    FontWeight="SemiBold"
                                    FontSize="15"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="{x:Bind MinecraftVersion}"
                                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                    FontSize="12" />
                                <TextBlock
                                    Text="{x:Bind LoaderType}"
                                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                    FontSize="12" />
                                <TextBlock
                                    Text="{x:Bind StatusText, Mode=OneWay}"
                                    Foreground="{ThemeResource SystemAccentColor}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{x:Bind HasStatusText, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                                <Button
                                    DataContext="{x:Bind}"
                                    Click="Play_Click"
                                    IsEnabled="{x:Bind IsNotLaunching, Mode=OneWay}"
                                    ToolTipService.ToolTip="Launch"
                                    Padding="8,6">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <ProgressRing
                                            IsActive="{x:Bind IsLaunching, Mode=OneWay}"
                                            Width="14" Height="14"
                                            Visibility="{x:Bind IsLaunching, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                        <FontIcon
                                            Glyph="&#xE768;"
                                            FontSize="14"
                                            Visibility="{x:Bind IsNotLaunching, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    DataContext="{x:Bind}"
                                    Click="Edit_Click"
                                    ToolTipService.ToolTip="Settings"
                                    Padding="8,6">
                                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
