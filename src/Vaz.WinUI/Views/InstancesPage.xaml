<Page
    x:Class="Vaz.WinUI.Views.InstancesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abs="using:Vazer.Core.Abstractions">

    <Grid RowDefinitions="Auto,*" Padding="24,16,24,16" RowSpacing="12">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Text="Instances" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Click="NewInstance_Click" ToolTipService.ToolTip="New Instance">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Add" />
                    <TextBlock Text="New" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Empty state -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.HasNoInstances, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <FontIcon Glyph="&#xE7F8;" FontSize="48" Opacity="0.4" />
            <TextBlock Text="Chưa có instance nào." HorizontalAlignment="Center" Opacity="0.6" />
            <TextBlock Text="Bấm + để tạo instance mới." HorizontalAlignment="Center" Opacity="0.4" />
        </StackPanel>

        <!-- Instance grid -->
        <GridView
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Instances}"
            IsItemClickEnabled="True"
            ItemClick="Instance_Click"
            Visibility="{x:Bind ViewModel.HasInstances, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="abs:MinecraftInstance">
                    <Border
                        Width="220" MinHeight="120"
                        Padding="12"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <Grid RowDefinitions="*,Auto" RowSpacing="8">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    Text="{x:Bind Name}"
                                    FontWeight="SemiBold"
                                    FontSize="15"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="{x:Bind MinecraftVersion}"
                                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                    FontSize="12" />
                                <TextBlock
                                    Text="{x:Bind LoaderType}"
                                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                    FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
                                <Button
                                    Tag="{x:Bind Id}"
                                    Click="Play_Click"
                                    ToolTipService.ToolTip="Launch"
                                    Padding="6,4">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                </Button>
                                <Button
                                    Tag="{x:Bind Id}"
                                    Click="Edit_Click"
                                    ToolTipService.ToolTip="Settings"
                                    Padding="6,4">
                                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
