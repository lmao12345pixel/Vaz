<UserControl
    x:Class="Vaz.WinUI.Views.ModCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Vaz.WinUI.ViewModels"
    x:Name="CardRoot">

    <UserControl.Resources>
        <Storyboard x:Name="HoverEnterStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="CardScale"
                Storyboard.TargetProperty="ScaleX"
                To="1.02"
                Duration="0:0:0.2" />
            <DoubleAnimation
                Storyboard.TargetName="CardScale"
                Storyboard.TargetProperty="ScaleY"
                To="1.02"
                Duration="0:0:0.2" />
        </Storyboard>
        <Storyboard x:Name="HoverExitStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="CardScale"
                Storyboard.TargetProperty="ScaleX"
                To="1.0"
                Duration="0:0:0.2" />
            <DoubleAnimation
                Storyboard.TargetName="CardScale"
                Storyboard.TargetProperty="ScaleY"
                To="1.0"
                Duration="0:0:0.2" />
        </Storyboard>
    </UserControl.Resources>

    <Border
        x:Name="CardBorder"
        Margin="0,4"
        Padding="14"
        CornerRadius="8"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        PointerEntered="Card_PointerEntered"
        PointerExited="Card_PointerExited"
        SizeChanged="Card_SizeChanged">
        
        <Border.RenderTransform>
            <ScaleTransform x:Name="CardScale" ScaleX="1.0" ScaleY="1.0" />
        </Border.RenderTransform>

        <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="16">
            <!-- Mod Icon (Lazy load, DecodePixelWidth 100) -->
            <Border
                Grid.Column="0"
                Width="48" Height="48"
                CornerRadius="6"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Image
                    x:Name="ModIconImage"
                    Width="48" Height="48"
                    Stretch="UniformToFill"
                    Source="{x:Bind Item.IconImageSource, Mode=OneWay}"
                    ImageFailed="IconImage_Failed" />
            </Border>

            <!-- Mod Info -->
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        Text="{x:Bind Item.Title, Mode=OneWay}"
                        FontWeight="SemiBold"
                        FontSize="15"
                        TextTrimming="CharacterEllipsis" />
                    <!-- Verify Badge when already installed -->
                    <Border
                        Visibility="{x:Bind Item.IsInstalledVisibility, Mode=OneWay}"
                        Background="#059669"
                        CornerRadius="4"
                        Padding="6,1"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="White" />
                            <TextBlock
                                Text="Đã cài"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="White" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        Text="{x:Bind Item.Author, Mode=OneWay}"
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        Text="•"
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind Item.DownloadsText, Mode=OneWay}"
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        Text="downloads"
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>

                <TextBlock
                    Text="{x:Bind Item.Description, Mode=OneWay}"
                    MaxLines="2"
                    TextWrapping="Wrap"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Margin="0,2,0,0" />
            </StackPanel>

            <!-- Install Button State Machine -->
            <Grid Grid.Column="2" VerticalAlignment="Center" MinWidth="88">
                <!-- State 1: Idle (Cài đặt) -->
                <Button
                    x:Name="InstallButton"
                    Visibility="{x:Bind Item.CanInstallVisibility, Mode=OneWay}"
                    Click="InstallButton_Click"
                    Padding="12,6"
                    HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Download" />
                        <TextBlock Text="Cài" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <!-- State 2: Installing (ProgressRing Spinner) -->
                <StackPanel
                    Visibility="{x:Bind Item.IsInstallingVisibility, Mode=OneWay}"
                    Orientation="Horizontal"
                    Spacing="6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <ProgressRing IsActive="True" Width="20" Height="20" />
                    <TextBlock
                        Text="Đang cài..."
                        FontSize="12"
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>

                <!-- State 3: Installed (Verify Badge) -->
                <Border
                    Visibility="{x:Bind Item.IsInstalledVisibility, Mode=OneWay}"
                    Background="#10B981"
                    CornerRadius="6"
                    Padding="10,6"
                    HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="White" />
                        <TextBlock Text="Đã cài" FontWeight="SemiBold" FontSize="12" Foreground="White" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
