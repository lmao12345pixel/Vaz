<UserControl
    x:Class="Vaz.WinUI.Views.ModCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Vaz.WinUI.ViewModels"
    x:Name="CardRoot">

    <UserControl.Resources>
        <!-- 1. Hover Animation: Scale 1.02 + Emerald border glow in 200ms with CubicEase -->
        <Storyboard x:Name="HoverEnterStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="CardScale"
                Storyboard.TargetProperty="ScaleX"
                To="1.02"
                Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="CardScale"
                Storyboard.TargetProperty="ScaleY"
                To="1.02"
                Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="HoverBorder"
                Storyboard.TargetProperty="Opacity"
                To="1.0"
                Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Name="HoverExitStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="CardScale"
                Storyboard.TargetProperty="ScaleX"
                To="1.0"
                Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="CardScale"
                Storyboard.TargetProperty="ScaleY"
                To="1.0"
                Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="HoverBorder"
                Storyboard.TargetProperty="Opacity"
                To="0.0"
                Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 2. Staggered Entrance Animation: TranslateY 20 -> 0 + Opacity 0 -> 1 in 250ms with CubicEase -->
        <Storyboard x:Name="EntranceStoryboard">
            <DoubleAnimation
                x:Name="EntranceTranslateAnim"
                Storyboard.TargetName="CardTranslate"
                Storyboard.TargetProperty="Y"
                From="20"
                To="0"
                Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                x:Name="EntranceOpacityAnim"
                Storyboard.TargetName="CardContainer"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 3. Install Button State Machine Cross-Fade Animations -->
        <Storyboard x:Name="FadeToInstallingStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="IdleContainer"
                Storyboard.TargetProperty="Opacity"
                To="0.0"
                Duration="0:0:0.1">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="InstallingContainer"
                Storyboard.TargetProperty="Opacity"
                To="1.0"
                BeginTime="0:0:0.05"
                Duration="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="InstalledContainer"
                Storyboard.TargetProperty="Opacity"
                To="0.0"
                Duration="0:0:0.1" />
        </Storyboard>

        <Storyboard x:Name="FadeToInstalledStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="InstallingContainer"
                Storyboard.TargetProperty="Opacity"
                To="0.0"
                Duration="0:0:0.1">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="IdleContainer"
                Storyboard.TargetProperty="Opacity"
                To="0.0"
                Duration="0:0:0.1" />
            <DoubleAnimation
                Storyboard.TargetName="InstalledContainer"
                Storyboard.TargetProperty="Opacity"
                To="1.0"
                BeginTime="0:0:0.05"
                Duration="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Name="FadeToIdleStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="InstallingContainer"
                Storyboard.TargetProperty="Opacity"
                To="0.0"
                Duration="0:0:0.1" />
            <DoubleAnimation
                Storyboard.TargetName="InstalledContainer"
                Storyboard.TargetProperty="Opacity"
                To="0.0"
                Duration="0:0:0.1" />
            <DoubleAnimation
                Storyboard.TargetName="IdleContainer"
                Storyboard.TargetProperty="Opacity"
                To="1.0"
                BeginTime="0:0:0.05"
                Duration="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid
        x:Name="CardContainer"
        Margin="0,4"
        PointerEntered="Card_PointerEntered"
        PointerExited="Card_PointerExited"
        SizeChanged="Card_SizeChanged">

        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="CardScale" ScaleX="1.0" ScaleY="1.0" />
                <TranslateTransform x:Name="CardTranslate" X="0" Y="0" />
            </TransformGroup>
        </Grid.RenderTransform>

        <Border
            x:Name="CardBorder"
            Padding="14"
            CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">

            <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="16">
                <!-- Mod Icon (Lazy load, DecodePixelWidth 100) -->
                <Border
                    Grid.Column="0"
                    Width="48" Height="48"
                    CornerRadius="6"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Image
                        x:Name="ModIconImage"
                        Width="48" Height="48"
                        Stretch="UniformToFill"
                        Source="{x:Bind Item.IconImageSource, Mode=OneWay}"
                        ImageFailed="IconImage_Failed" />
                </Border>

                <!-- Mod Info -->
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            Text="{x:Bind Item.Title, Mode=OneWay}"
                            FontWeight="SemiBold"
                            FontSize="15"
                            TextTrimming="CharacterEllipsis" />
                        <!-- Verify Badge when already installed -->
                        <Border
                            Visibility="{x:Bind Item.IsInstalledVisibility, Mode=OneWay}"
                            Background="#059669"
                            CornerRadius="4"
                            Padding="6,1"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="White" />
                                <TextBlock
                                    Text="Đã cài"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="White" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            Text="{x:Bind Item.Author, Mode=OneWay}"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock
                            Text="•"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock
                            Text="{x:Bind Item.DownloadsText, Mode=OneWay}"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock
                            Text="downloads"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>

                    <TextBlock
                        Text="{x:Bind Item.Description, Mode=OneWay}"
                        MaxLines="2"
                        TextWrapping="Wrap"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Margin="0,2,0,0" />
                </StackPanel>

                <!-- Install Button State Machine with Cross-Fade Transition -->
                <Grid Grid.Column="2" VerticalAlignment="Center" MinWidth="92">
                    <!-- State 1: Idle (Cài đặt) -->
                    <Button
                        x:Name="IdleContainer"
                        Click="InstallButton_Click"
                        Padding="12,6"
                        HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Download" />
                            <TextBlock Text="Cài" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- State 2: Installing (ProgressRing Spinner) -->
                    <StackPanel
                        x:Name="InstallingContainer"
                        Orientation="Horizontal"
                        Spacing="6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Opacity="0"
                        IsHitTestVisible="False">
                        <ProgressRing IsActive="True" Width="20" Height="20" />
                        <TextBlock
                            Text="Đang cài..."
                            FontSize="12"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- State 3: Installed (Verify Badge) -->
                    <Border
                        x:Name="InstalledContainer"
                        Background="#10B981"
                        CornerRadius="6"
                        Padding="10,6"
                        HorizontalAlignment="Right"
                        Opacity="0"
                        IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="White" />
                            <TextBlock Text="Đã cài" FontWeight="SemiBold" FontSize="12" Foreground="White" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Hover Glow Border Overlay (Smooth Hardware-Accelerated Opacity Transition) -->
        <Border
            x:Name="HoverBorder"
            CornerRadius="8"
            BorderBrush="#10B981"
            BorderThickness="1"
            Opacity="0"
            IsHitTestVisible="False" />
    </Grid>
</UserControl>
