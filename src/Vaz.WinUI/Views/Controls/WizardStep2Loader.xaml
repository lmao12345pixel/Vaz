<UserControl
    x:Class="Vaz.WinUI.Views.Controls.WizardStep2Loader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10" Padding="24,10,24,6">
        <!-- Hero + breadcrumb -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Chọn Mod Loader" Margin="0,0,0,16" Style="{StaticResource MkVibeTitleStyle}" />
            <TextBlock x:Name="BreadcrumbText"
                       Text="Bước 2/3 · Minecraft"
                       Margin="0,0,0,24"
                       FontSize="13"
                       FontFamily="{ThemeResource MkVibePixelFont}"
                       Foreground="{ThemeResource MkVibeMutedTextBrush}" />
        </StackPanel>

        <!-- Main content: 2 cột (left: loader cards + name + loader version | right: live preview) -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="18">
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <!-- 5 loader cards ngang -->
                    <Grid x:Name="LoaderGrid" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
                        <!-- Vanilla -->
                        <Button x:Name="VanillaButton" Grid.Column="0" Tag="Vanilla" Click="LoaderButton_Click"
                                HorizontalContentAlignment="Stretch" Padding="0"
                                CornerRadius="{ThemeResource MkVibeBlockCorner}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="3">
                            <StackPanel Padding="8,10" Spacing="6">
                                <Border Height="52" CornerRadius="{ThemeResource MkVibeBlockCorner}" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <Image x:Name="VanillaLogo" Source="ms-appx:///Assets/loaders/vanilla-logo.png"
                                           MaxWidth="38" MaxHeight="38" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Vanilla" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="Không mod" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center" TextAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Fabric -->
                        <Button x:Name="FabricButton" Grid.Column="1" Tag="Fabric" Click="LoaderButton_Click"
                                HorizontalContentAlignment="Stretch" Padding="0"
                                CornerRadius="{ThemeResource MkVibeBlockCorner}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="3">
                            <StackPanel Padding="8,10" Spacing="6">
                                <Border Height="52" CornerRadius="{ThemeResource MkVibeBlockCorner}" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <Image x:Name="FabricLogo" Source="ms-appx:///Assets/loaders/fabric-logo.png"
                                           MaxWidth="38" MaxHeight="38" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Fabric" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="Nhanh, nhẹ" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center" TextAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Quilt -->
                        <Button x:Name="QuiltButton" Grid.Column="2" Tag="Quilt" Click="LoaderButton_Click"
                                HorizontalContentAlignment="Stretch" Padding="0"
                                CornerRadius="{ThemeResource MkVibeBlockCorner}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="3">
                            <StackPanel Padding="8,10" Spacing="6">
                                <Border Height="52" CornerRadius="{ThemeResource MkVibeBlockCorner}" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <Image x:Name="QuiltLogo" Source="ms-appx:///Assets/loaders/quilt-logo.png"
                                           MaxWidth="38" MaxHeight="38" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Quilt" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="Tương thích" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center" TextAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- NeoForge -->
                        <Button x:Name="NeoForgeButton" Grid.Column="3" Tag="NeoForge" Click="LoaderButton_Click"
                                HorizontalContentAlignment="Stretch" Padding="0"
                                CornerRadius="{ThemeResource MkVibeBlockCorner}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="3">
                            <StackPanel Padding="8,10" Spacing="6">
                                <Border Height="52" CornerRadius="{ThemeResource MkVibeBlockCorner}" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <Image x:Name="NeoForgeLogo" Source="ms-appx:///Assets/loaders/neoforge-logo.png"
                                           MaxWidth="38" MaxHeight="38" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="NeoForge" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="Hiện đại" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center" TextAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Forge -->
                        <Button x:Name="ForgeButton" Grid.Column="4" Tag="Forge" Click="LoaderButton_Click"
                                HorizontalContentAlignment="Stretch" Padding="0"
                                CornerRadius="{ThemeResource MkVibeBlockCorner}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="3">
                            <StackPanel Padding="8,10" Spacing="6">
                                <Border Height="52" CornerRadius="{ThemeResource MkVibeBlockCorner}" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <Image x:Name="ForgeLogo" Source="ms-appx:///Assets/loaders/forge-logo.png"
                                           MaxWidth="46" MaxHeight="32" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Forge" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="Truyền thống" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center" TextAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Tên instance -->
                    <TextBox x:Name="NameBox"
                             Header="Tên instance"
                             PlaceholderText="New Instance"
                             Text="New Instance" />

                    <!-- Loader version area (hiển thị sau khi chọn loader) -->
                    <StackPanel x:Name="LoaderVersionPanel" Spacing="8" Visibility="Collapsed">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Loader version" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ProgressRing x:Name="LoaderLoadingRing" Grid.Column="1" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                        </Grid>
                        <ComboBox x:Name="LoaderVersionBox"
                                  HorizontalAlignment="Stretch" />
                        <TextBlock x:Name="NoLoaderVersionsText"
                                   Text="Không có version tương thích"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed" />
                    </StackPanel>

                    <!-- Ghi chú khi chọn Vanilla -->
                    <InfoBar x:Name="VanillaNote"
                             IsOpen="False"
                             Severity="Informational"
                             Title="Vanilla"
                             Message="Vanilla không cần chọn loader version — game sẽ được cài như bản gốc." />
                </StackPanel>
            </ScrollViewer>

            <!-- Live preview panel (tóm tắt cấu hình) -->
            <Border x:Name="PreviewPanel"
                    Grid.Column="1"
                    Width="270"
                    VerticalAlignment="Top"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="3"
                    CornerRadius="{ThemeResource MkVibeBlockCorner}"
                    Padding="18,20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Tóm tắt" FontSize="16" FontWeight="SemiBold" />
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <FontIcon Glyph="&#xE8B5;" FontSize="14" Foreground="{StaticResource VazAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" x:Name="PreviewVersion" Text="Minecraft" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <FontIcon Glyph="&#xE902;" FontSize="14" Foreground="{StaticResource VazAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" x:Name="PreviewLoader" Text="Loader" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <FontIcon Glyph="&#xE896;" FontSize="14" Foreground="{StaticResource VazAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="PreviewSize" Text="~214 MB" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="Ước tính tải xuống" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <TextBlock x:Name="PreviewHint"
                               Text="Chọn loader để xem tóm tắt cấu hình."
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               LineHeight="16" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
            <Button x:Name="BackButton"
                    Grid.Column="0"
                    Content="← Quay lại"
                    Height="36"
                    Padding="16,7"
                    CornerRadius="6"
                    Click="BackButton_Click" />
            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Content="Hủy"
                    Height="36"
                    Padding="16,7"
                    CornerRadius="6"
                    Click="CancelButton_Click" />
            <Button x:Name="CreateButton"
                    Grid.Column="3"
                    Content="Tiếp tục →"
                    Style="{StaticResource VazAccentButtonStyle}"
                    Height="36"
                    Padding="22,7"
                    CornerRadius="6"
                    FontWeight="SemiBold"
                    FontSize="13"
                    Click="CreateButton_Click"
                    IsEnabled="False" />
        </Grid>
    </Grid>
</UserControl>
