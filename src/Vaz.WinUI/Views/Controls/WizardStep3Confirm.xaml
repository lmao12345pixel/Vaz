<UserControl
    x:Class="Vaz.WinUI.Views.Controls.WizardStep3Confirm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="PreviewGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop x:Name="GradientStop1" Color="#10B981" Offset="0" />
            <GradientStop x:Name="GradientStop2" Color="#0D9C6E" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CreateGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#22C55E" Offset="0" />
            <GradientStop Color="#10B981" Offset="0.55" />
            <GradientStop Color="#06D6A0" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="VanillaGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8A5A2B" Offset="0" />
            <GradientStop Color="#4E7A34" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FabricGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F59E0B" Offset="0" />
            <GradientStop Color="#D97706" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="QuiltGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3B82F6" Offset="0" />
            <GradientStop Color="#8B5CF6" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NeoForgeGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EF4444" Offset="0" />
            <GradientStop Color="#F97316" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ForgeGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B45309" Offset="0" />
            <GradientStop Color="#78350F" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10" Padding="24,10,24,6">
        <!-- Hero + subtitle -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Xác nhận &amp; tạo" FontSize="26" FontWeight="SemiBold" />
            <TextBlock x:Name="BreadcrumbText"
                       Text="Kiểm tra cấu hình trước khi tạo instance."
                       FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Preview card -->
        <Border x:Name="PreviewCard"
                Grid.Row="1"
                Width="500"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource PreviewGradientBrush}"
                CornerRadius="{StaticResource VazRadiusLg}"
                Padding="26,22,26,18">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                <!-- Big loader tile -->
                <Border x:Name="LoaderTile"
                        Grid.Row="0"
                        Width="104"
                        Height="104"
                        CornerRadius="24"
                        HorizontalAlignment="Center"
                        Background="{StaticResource FabricGradient}">
                    <TextBlock x:Name="LoaderGlyph"
                               Text="F"
                               FontSize="46"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <TextBlock x:Name="VersionLine"
                           Grid.Row="1"
                           Text="Minecraft 1.21.1"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center" />

                <TextBlock x:Name="LoaderLine"
                           Grid.Row="2"
                           Text="Fabric"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="#E8FFFFFF"
                           HorizontalAlignment="Center" />

                <!-- Editable name -->
                <Grid Grid.Row="3" Margin="10,2,10,0">
                    <TextBox x:Name="NameBox"
                             Text="Fabric 1.21.1 #1"
                             PlaceholderText=""
                             Padding="16,22,16,6"
                             FontSize="15"
                             Background="#1AFFFFFF"
                             BorderBrush="#33FFFFFF"
                             BorderThickness="1"
                             CornerRadius="10"
                             Foreground="White"
                             HorizontalAlignment="Stretch" />
                    <TextBlock x:Name="FloatingLabel"
                               Text="Tên instance"
                               FontSize="11"
                               Foreground="#E0FFFFFF"
                               Margin="16,6,16,0"
                               VerticalAlignment="Top"
                               IsHitTestVisible="False" />
                </Grid>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
            <Button x:Name="BackButton"
                    Grid.Column="0"
                    Content="← Quay lại"
                    Height="36"
                    Padding="16,7"
                    CornerRadius="6"
                    Click="BackButton_Click" />
            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Content="Hủy"
                    Height="36"
                    Padding="16,7"
                    CornerRadius="6"
                    Click="CancelButton_Click" />

            <!-- Create button host + glow -->
            <Grid Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border x:Name="CreateGlow"
                        CornerRadius="18"
                        Background="{StaticResource CreateGradient}"
                        Opacity="0.0"
                        Width="220"
                        Height="52" />
                <Button x:Name="CreateButton"
                        Height="38"
                        MinWidth="170"
                        Padding="20,7"
                        CornerRadius="19"
                        BorderThickness="0"
                        Background="{StaticResource CreateGradient}"
                        Foreground="White"
                        FontWeight="SemiBold"
                        FontSize="14"
                        IsEnabled="False"
                        Click="CreateButton_Click">
                    <Button.Content>
                        <Grid>
                            <!-- Normal content -->
                            <StackPanel x:Name="NormalContent"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE73E;" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock x:Name="ActionLabel" Text="Tạo Instance" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Loading content: ring + percent + stage text -->
                            <StackPanel x:Name="LoadingContent"
                                        Visibility="Collapsed"
                                        Opacity="0"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <ProgressRing x:Name="CreateRing"
                                              IsActive="True"
                                              Width="16"
                                              Height="16"
                                              Foreground="White"
                                              VerticalAlignment="Center" />
                                <TextBlock x:Name="StageText"
                                           Text="Đang chuẩn bị..."
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="PercentText"
                                           Text=""
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Visibility="Collapsed"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Success content: checkmark bounce + success message -->
                            <StackPanel x:Name="SuccessContent"
                                        Visibility="Collapsed"
                                        Opacity="0"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Border Width="22" Height="22" CornerRadius="11" Background="White" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="#10B981" FontWeight="Bold"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Đã tạo thành công!"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Button.Content>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
