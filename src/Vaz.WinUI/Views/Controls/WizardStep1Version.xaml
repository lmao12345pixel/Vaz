<UserControl
    x:Class="Vaz.WinUI.Views.Controls.WizardStep1Version"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10" Padding="24,10,24,6">
        <!-- Hero header -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Bạn muốn chơi phiên bản nào?" Margin="0,0,0,16" Style="{StaticResource MkVibeTitleStyle}" />
            <TextBlock Text="Chọn phiên bản Minecraft — bản đã cài có nhãn &#8220;Đã cài&#8221;."
                       Margin="0,0,0,24"
                       FontSize="13"
                       FontFamily="{ThemeResource MkVibePixelFont}"
                       Foreground="{ThemeResource MkVibeMutedTextBrush}" />
        </StackPanel>

        <!-- Search -->
        <Border
            x:Name="SearchGlow"
            Grid.Row="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="3"
            CornerRadius="{ThemeResource MkVibeBlockCorner}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            Height="44">
            <Grid ColumnDefinitions="Auto,*">
                <FontIcon Glyph="&#xE721;" FontSize="16" VerticalAlignment="Center" Margin="14,0,0,0"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="1"
                    PlaceholderText="Tìm version (vd: 1.21, 26.3, snapshot)..."
                    BorderThickness="0"
                    Background="Transparent"
                    FontSize="15"
                    VerticalContentAlignment="Center"
                    Padding="12,6,12,6" />
            </Grid>
        </Border>

        <!-- Cards grid — Grid do code dựng (ItemsRepeater/UniformGridLayout làm XamlCompiler 1.5 crash) -->
        <ScrollViewer x:Name="CardScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" SizeChanged="CardScroll_SizeChanged">
            <Grid x:Name="CardGrid" HorizontalAlignment="Center" VerticalAlignment="Top"
                  ColumnSpacing="14" RowSpacing="14" />
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Button x:Name="CancelButton"
                    Grid.Column="0"
                    Content="Hủy"
                    Height="36"
                    Padding="18,7"
                    CornerRadius="6"
                    Click="CancelButton_Click" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressRing x:Name="LoadingRing" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText"
                           Text="Đang tải danh sách version..."
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="Collapsed"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Button x:Name="ContinueButton"
                    Grid.Column="2"
                    Content="Tiếp tục →"
                    Style="{StaticResource VazAccentButtonStyle}"
                    Height="36"
                    Padding="22,7"
                    CornerRadius="6"
                    FontWeight="SemiBold"
                    FontSize="13"
                    HorizontalAlignment="Right"
                    IsEnabled="False"
                    Click="ContinueButton_Click" />
        </Grid>
    </Grid>
</UserControl>
