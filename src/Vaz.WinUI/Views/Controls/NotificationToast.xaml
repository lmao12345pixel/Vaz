<UserControl
    x:Class="Vaz.WinUI.Views.Controls.NotificationToast"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="400"
    HorizontalAlignment="Right"
    RenderTransformOrigin="0.5,0.5">

    <UserControl.RenderTransform>
        <TransformGroup>
            <TranslateTransform x:Name="ToastTranslate" X="400" />
            <ScaleTransform x:Name="ToastScale" ScaleX="1.0" ScaleY="1.0" />
        </TransformGroup>
    </UserControl.RenderTransform>

    <Border x:Name="ToastCard"
            CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Padding="0"
            PointerEntered="ToastCard_PointerEntered"
            PointerExited="ToastCard_PointerExited"
            PointerPressed="ToastCard_PointerPressed">

        <Grid RowDefinitions="*,Auto">
            <!-- Main Content Row -->
            <Grid Grid.Row="0" ColumnDefinitions="4,Auto,Auto,*,Auto" MinHeight="68">
                <!-- Left Type Color Bar -->
                <Border x:Name="TypeColorBar"
                        Grid.Column="0"
                        Width="4"
                        CornerRadius="4,0,0,4"
                        HorizontalAlignment="Left" />

                <!-- Type Icon -->
                <FontIcon x:Name="TypeIcon"
                          Grid.Column="1"
                          FontSize="16"
                          Margin="12,14,0,0"
                          VerticalAlignment="Top" />

                <!-- Rich Media Image (Optional, e.g. Mod Icon) -->
                <Border x:Name="RichMediaContainer"
                        Grid.Column="2"
                        Width="44" Height="44"
                        CornerRadius="6"
                        Margin="10,12,0,12"
                        VerticalAlignment="Top"
                        Visibility="Collapsed">
                    <Image x:Name="RichMediaImage"
                           Stretch="UniformToFill" />
                </Border>

                <!-- Text & Action Stack -->
                <StackPanel Grid.Column="3"
                            Margin="10,12,8,12"
                            VerticalAlignment="Center"
                            Spacing="3">
                    <!-- Title & Group Badge -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleTextBlock"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />

                        <Border x:Name="GroupBadgeBorder"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8"
                                Padding="6,1"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                            <TextBlock x:Name="GroupBadgeTextBlock"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- Message -->
                    <TextBlock x:Name="MessageTextBlock"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               MaxLines="3"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                        <HyperlinkButton x:Name="ActionButton1"
                                         Visibility="Collapsed"
                                         Padding="0,2,0,0"
                                         FontSize="12"
                                         FontWeight="SemiBold"
                                         Click="ActionButton1_Click" />

                        <HyperlinkButton x:Name="ActionButton2"
                                         Visibility="Collapsed"
                                         Padding="0,2,0,0"
                                         FontSize="12"
                                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                         Click="ActionButton2_Click" />
                    </StackPanel>
                </StackPanel>

                <!-- Hover Close Button (X) -->
                <Button x:Name="CloseButton"
                        Grid.Column="4"
                        Width="22"
                        Height="22"
                        Padding="0"
                        Margin="0,8,8,0"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="4"
                        Opacity="0"
                        Click="CloseButton_Click"
                        AutomationProperties.Name="Đóng thông báo">
                    <FontIcon Glyph="&#xE711;" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>
            </Grid>

            <!-- Bottom Progress Bar (2px) -->
            <Border Grid.Row="1"
                    Height="2"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="0,0,8,8"
                    HorizontalAlignment="Stretch">
                <Rectangle x:Name="ProgressBarFill"
                           Height="2"
                           HorizontalAlignment="Stretch"
                           RenderTransformOrigin="0,0.5">
                    <Rectangle.RenderTransform>
                        <ScaleTransform x:Name="ProgressScale" ScaleX="1.0" />
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Border>
        </Grid>
    </Border>
</UserControl>
