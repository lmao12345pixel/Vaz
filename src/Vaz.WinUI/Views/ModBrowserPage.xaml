<Page
    x:Class="Vaz.WinUI.Views.ModBrowserPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Vaz.WinUI.ViewModels"
    NavigationCacheMode="Required">

    <Grid x:Name="PageRoot" RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="16,12,16,12" RowSpacing="8">

        <!-- Search bar -->
        <AutoSuggestBox
            Grid.Row="0"
            x:Name="SearchBox"
            PlaceholderText="Tìm mod trên Modrinth..."
            QueryIcon="Find"
            TextChanged="SearchBox_TextChanged"
            QuerySubmitted="SearchBox_QuerySubmitted" />

        <!-- Filter row -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8">
            <ComboBox
                Grid.Column="0"
                Header="Loader"
                ItemsSource="{x:Bind ViewModel.LoaderOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedLoader, Mode=TwoWay}"
                MinWidth="120" />
            <ComboBox
                Grid.Column="1"
                Header="MC version"
                ItemsSource="{x:Bind ViewModel.VersionOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedGameVersion, Mode=TwoWay}"
                MinWidth="120" />
            <ComboBox
                Grid.Column="2"
                Header="Sort"
                ItemsSource="{x:Bind ViewModel.SortOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}"
                MinWidth="120" />
            <Button
                Grid.Column="3"
                VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.InstallPerformancePackCommand}"
                IsEnabled="{x:Bind ViewModel.CanInstallPerformancePack, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE945;" FontSize="14" />
                    <TextBlock Text="Performance Pack" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Status / error -->
        <StackPanel Grid.Row="2" Spacing="4">
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=TwoWay}"
                Severity="Error"
                Title="Lỗi"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Thử lại" Command="{x:Bind ViewModel.RetryCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasWarning, Mode=OneWay}"
                Severity="Warning"
                Title="Cảnh báo"
                Message="{x:Bind ViewModel.WarningMessage, Mode=OneWay}" />
            <TextBlock
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
            <ProgressBar
                Height="4"
                IsIndeterminate="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                Maximum="100"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- Results -->
        <ScrollViewer Grid.Row="3">
            <Grid>
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:SearchHitRow">
                        <Border
                            Padding="12"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            Tag="{x:Bind}"
                            Tapped="Card_Tapped">
                            <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="12">
                                <Image
                                    Grid.Column="0"
                                    Width="64" Height="64"
                                    Stretch="UniformToFill"
                                    Source="{x:Bind IconUrl}"
                                    ImageFailed="IconImageFailed" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock
                                        Text="{x:Bind Title}"
                                        FontWeight="SemiBold"
                                        TextWrapping="NoWrap"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind Author}"
                                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Text="{x:Bind Description}"
                                        MaxLines="2"
                                        TextWrapping="Wrap"
                                        TextTrimming="CharacterEllipsis"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74C;" FontSize="12" />
                                        <TextBlock
                                            Text="{x:Bind DownloadsText}"
                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </StackPanel>
                                <Button
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Content="Cài"
                                    Command="{Binding ViewModel.InstallCommand, ElementName=RootPage}"
                                    CommandParameter="{x:Bind}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <FontIcon Glyph="&#xE721;" FontSize="32" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                <TextBlock Text="No results" HorizontalAlignment="Center" />
            </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Load more -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto,*" Padding="0,4">
            <Button
                Grid.Column="1"
                Content="Load more"
                Command="{x:Bind ViewModel.LoadMoreCommand}"
                IsEnabled="{x:Bind ViewModel.CanLoadMore, Mode=OneWay}" />
            <ProgressRing
                Grid.Column="2"
                Width="20" Height="20"
                IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
