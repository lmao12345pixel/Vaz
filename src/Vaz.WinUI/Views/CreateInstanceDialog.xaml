<ContentDialog
    x:Class="Vaz.WinUI.Views.CreateInstanceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Tạo instance mới"
    PrimaryButtonText="Tạo"
    CloseButtonText="Hủy"
    DefaultButton="Primary"
    PrimaryButtonClick="Dialog_PrimaryButtonClick">
    <StackPanel Spacing="8" MinWidth="380">
        <TextBox
            x:Name="NameBox"
            Header="Tên instance"
            PlaceholderText="New Instance" />

        <ComboBox
            x:Name="LoaderCombo"
            Header="Loader"
            HorizontalAlignment="Stretch" />

        <ComboBox
            x:Name="VersionCombo"
            Header="Minecraft version"
            HorizontalAlignment="Stretch" />

        <TextBox
            x:Name="LoaderVersionBox"
            Header="Loader version (để trống = latest)"
            PlaceholderText="latest" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <ProgressRing x:Name="BusyRing" IsActive="False" Width="20" Height="20" />
            <TextBlock x:Name="BusyText" Text="" VerticalAlignment="Center" Visibility="Collapsed" />
        </StackPanel>

        <InfoBar
            x:Name="CreateErrorBar"
            IsOpen="False"
            Severity="Error"
            Title="Tạo instance thất bại"
            Message="" />
    </StackPanel>
</ContentDialog>
