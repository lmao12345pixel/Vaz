<ContentDialog
    x:Class="Vaz.WinUI.Views.CreateInstanceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vaz.WinUI.Views.Controls"
    Title="Tạo instance mới"
    MaxWidth="880"
    MaxHeight="660">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">880</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">660</x:Double>
    </ContentDialog.Resources>
    <Grid Width="820" Height="540" RowDefinitions="*,Auto,Auto,Auto" RowSpacing="4">
        <!-- Step hosts -->
        <Grid x:Name="Step1Host" Grid.Row="0">
            <local:WizardStep1Version x:Name="Step1" />
        </Grid>
        <Grid x:Name="Step2Host" Grid.Row="0" Visibility="Collapsed" Opacity="0">
            <local:WizardStep2Loader x:Name="Step2" />
        </Grid>

        <!-- Progress UI khi đang cài -->
        <StackPanel Grid.Row="1" Spacing="2" Margin="0,4,0,0" Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}">
            <ProgressBar
                Minimum="0"
                Maximum="100"
                Height="4"
                IsIndeterminate="{Binding IsInstallerProgressIndeterminate}"
                Value="{Binding InstallerProgressPercent}" />
            <TextBlock
                Text="{Binding InstallMessage}"
                FontSize="12"
                TextTrimming="CharacterEllipsis"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- InfoBars -->
        <InfoBar
            x:Name="CreateWarningBar"
            Grid.Row="2"
            IsOpen="{Binding CanCreateInstance, Converter={StaticResource BoolNegationConverter}}"
            Severity="Warning"
            Title=""
            Message="{Binding CreateWarningMessage}" />
        <InfoBar
            x:Name="CreateErrorBar"
            Grid.Row="3"
            IsOpen="False"
            Severity="Error"
            Title="Tạo instance thất bại"
            Message="">
            <InfoBar.ActionButton>
                <Button x:Name="ViewInstallLogButton"
                        Content="Xem chi tiết lỗi"
                        Click="ViewInstallLogButton_Click" />
            </InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</ContentDialog>
