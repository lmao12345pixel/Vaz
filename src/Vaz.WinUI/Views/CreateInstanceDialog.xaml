<ContentDialog
    x:Class="Vaz.WinUI.Views.CreateInstanceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vaz.WinUI.Views.Controls"
    Title="Tạo instance mới"
    MaxWidth="880"
    MaxHeight="700">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">880</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">700</x:Double>
    </ContentDialog.Resources>
    <Grid x:Name="RootGrid" Width="820" Height="530" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="4">
        <!-- Top bar: Breadcrumb + Progress Indicator -->
        <Grid Grid.Row="0" Margin="24,6,24,2">
            <TextBlock x:Name="TopBreadcrumbText"
                       Text="Bước 1/3 · Chọn phiên bản"
                       FontSize="13"
                       FontWeight="Medium"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" />
            <local:WizardProgressIndicator x:Name="ProgressIndicator"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
        </Grid>

        <!-- Step container with 3 hosts -->
        <Grid x:Name="StepContainer" Grid.Row="1">
            <Grid x:Name="Step1Host">
                <local:WizardStep1Version x:Name="Step1" />
            </Grid>
            <Grid x:Name="Step2Host" Visibility="Collapsed" Opacity="0">
                <local:WizardStep2Loader x:Name="Step2" />
            </Grid>
            <Grid x:Name="Step3Host" Visibility="Collapsed" Opacity="0">
                <local:WizardStep3Confirm x:Name="Step3" />
            </Grid>
        </Grid>

        <!-- InfoBars -->
        <InfoBar
            x:Name="CreateWarningBar"
            Grid.Row="2"
            IsOpen="{Binding CanCreateInstance, Converter={StaticResource BoolNegationConverter}}"
            Severity="Warning"
            Title=""
            Message="{Binding CreateWarningMessage}" />
        <InfoBar
            x:Name="CreateErrorBar"
            Grid.Row="3"
            IsOpen="False"
            Severity="Error"
            Title="Tạo instance thất bại"
            Message="">
            <InfoBar.ActionButton>
                <Button x:Name="ViewInstallLogButton"
                        Content="Xem chi tiết lỗi"
                        Click="ViewInstallLogButton_Click" />
            </InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</ContentDialog>
