<ContentDialog
    x:Class="Vaz.WinUI.Views.CreateInstanceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Tạo instance mới"
    PrimaryButtonText="Tạo"
    CloseButtonText="Hủy"
    DefaultButton="Primary"
    PrimaryButtonClick="Dialog_PrimaryButtonClick"
    CloseButtonClick="Dialog_CloseButtonClick"
    IsPrimaryButtonEnabled="{Binding CanCreateAndNotBusy}">
    <StackPanel Spacing="8" MinWidth="380">
        <TextBox
            x:Name="NameBox"
            Header="Tên instance"
            PlaceholderText="New Instance" />

        <ComboBox
            x:Name="LoaderCombo"
            Header="Loader"
            HorizontalAlignment="Stretch" />

        <StackPanel>
            <ComboBox
                x:Name="VersionCombo"
                Header="Minecraft version"
                HorizontalAlignment="Stretch"
                IsEnabled="{Binding IsVersionsLoading, Converter={StaticResource BoolNegationConverter}}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Id}" VerticalAlignment="Center" />
                            <!-- B1: Badge "Đã cài" (versions/{id} tồn tại trên đĩa) -->
                            <Border Background="{StaticResource VazAccentBrush}"
                                    CornerRadius="4"
                                    Padding="4,2"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Đã cài" FontSize="11" />
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ProgressRing
                IsActive="{Binding IsVersionsLoading}"
                Width="16"
                Height="16"
                HorizontalAlignment="Left"
                Visibility="{Binding IsVersionsLoading, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <StackPanel>
            <ComboBox
                x:Name="LoaderVersionBox"
                Header="Loader version"
                PlaceholderText="Chọn loader version"
                HorizontalAlignment="Stretch"
                IsEnabled="{Binding IsLoaderVersionsLoading, Converter={StaticResource BoolNegationConverter}}" />
            <ProgressRing
                IsActive="{Binding IsLoaderVersionsLoading}"
                Width="16"
                Height="16"
                HorizontalAlignment="Left"
                Visibility="{Binding IsLoaderVersionsLoading, Converter={StaticResource BoolToVis}}" />
            <TextBlock
                x:Name="NoLoaderVersionsText"
                Text="Không có version tương thích"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Spacing="2" Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}">
            <ProgressBar
                Minimum="0"
                Maximum="100"
                Height="4"
                IsIndeterminate="{Binding IsInstallerProgressIndeterminate}"
                Value="{Binding InstallerProgressPercent}" />
            <TextBlock
                Text="{Binding InstallMessage}"
                FontSize="12"
                TextTrimming="CharacterEllipsis"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <InfoBar
            x:Name="CreateWarningBar"
            IsOpen="{Binding CanCreateInstance, Converter={StaticResource BoolNegationConverter}}"
            Severity="Warning"
            Title=""
            Message="{Binding CreateWarningMessage}" />

        <InfoBar
            x:Name="CreateErrorBar"
            IsOpen="False"
            Severity="Error"
            Title="Tạo instance thất bại"
            Message="">
            <InfoBar.ActionButton>
                <Button x:Name="ViewInstallLogButton"
                        Content="Xem chi tiết lỗi"
                        Click="ViewInstallLogButton_Click" />
            </InfoBar.ActionButton>
        </InfoBar>
    </StackPanel>
</ContentDialog>
