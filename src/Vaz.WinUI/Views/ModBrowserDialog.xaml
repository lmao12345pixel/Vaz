<ContentDialog
    x:Class="Vaz.WinUI.Views.ModBrowserDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Vaz.WinUI.ViewModels"
    Title="Download Mods"
    CloseButtonText="Đóng"
    DefaultButton="Close"
    MaxWidth="800"
    MinWidth="700">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="8" MinHeight="480">

        <!-- Search bar -->
        <AutoSuggestBox
            Grid.Row="0"
            x:Name="SearchBox"
            PlaceholderText="Tìm mod trên Modrinth..."
            QueryIcon="Find"
            TextChanged="SearchBox_TextChanged"
            QuerySubmitted="SearchBox_QuerySubmitted" />

        <!-- Filter row -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8">
            <ComboBox
                Grid.Column="0"
                Header="Loader"
                ItemsSource="{x:Bind ViewModel.LoaderOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedLoader, Mode=TwoWay}"
                MinWidth="120" />
            <ComboBox
                Grid.Column="1"
                Header="MC version"
                ItemsSource="{x:Bind ViewModel.VersionOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedGameVersion, Mode=TwoWay}"
                MinWidth="120" />
            <ComboBox
                Grid.Column="2"
                Header="Sort"
                ItemsSource="{x:Bind ViewModel.SortOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}"
                MinWidth="120" />
        </Grid>

        <!-- Status / error -->
        <StackPanel Grid.Row="2" Spacing="4">
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=TwoWay}"
                Severity="Error"
                Title="Lỗi"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            <TextBlock
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
            <ProgressBar
                Height="4"
                Maximum="100"
                Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- Results -->
        <ScrollViewer Grid.Row="3">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="4" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:SearchHitRow">
                        <Border
                            Padding="8"
                            CornerRadius="4"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            Tapped="Card_Tapped">
                            <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="12">
                                <Image
                                    Grid.Column="0"
                                    Width="48" Height="48"
                                    Stretch="UniformToFill"
                                    Source="{x:Bind IconUrl}"
                                    ImageFailed="IconImage_Failed" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind Author}"
                                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Text="{x:Bind Description}"
                                        MaxLines="2"
                                        TextWrapping="Wrap"
                                        TextTrimming="CharacterEllipsis"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4" HorizontalAlignment="Right">
                                    <TextBlock
                                        Text="{x:Bind DownloadsText}"
                                        HorizontalAlignment="Right"
                                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                    <Button
                                        Content="Cài"
                                        Click="Install_Click"
                                        Tag="{x:Bind Slug}"
                                        HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Load more -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button
                Content="Load more"
                Command="{x:Bind ViewModel.LoadMoreCommand}"
                Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
            <ProgressRing
                Width="20" Height="20"
                IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</ContentDialog>
