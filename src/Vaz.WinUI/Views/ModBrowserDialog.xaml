<ContentDialog
    x:Class="Vaz.WinUI.Views.ModBrowserDialog"
    x:Name="RootDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Vaz.WinUI.ViewModels"
    Title="Download Mods"
    CloseButtonText="Đóng"
    DefaultButton="Close"
    MaxWidth="820"
    MinWidth="720">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10" MinHeight="520">

        <!-- 1. Search bar -->
        <AutoSuggestBox
            Grid.Row="0"
            x:Name="SearchBox"
            PlaceholderText="Tìm mod trên Modrinth (ví dụ: sodium, iris, lithium)..."
            QueryIcon="Find"
            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
            TextChanged="SearchBox_TextChanged"
            QuerySubmitted="SearchBox_QuerySubmitted"
            HorizontalAlignment="Stretch" />

        <!-- 2. Filter row -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <ComboBox
                Header="Loader"
                ItemsSource="{x:Bind ViewModel.LoaderOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedLoader, Mode=TwoWay}"
                MinWidth="130" />
            <ComboBox
                Header="MC version"
                ItemsSource="{x:Bind ViewModel.VersionOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedGameVersion, Mode=TwoWay}"
                MinWidth="130" />
            <ComboBox
                Header="Sort"
                ItemsSource="{x:Bind ViewModel.SortOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}"
                MinWidth="130" />
        </StackPanel>

        <!-- 3. Status / error / progress -->
        <StackPanel Grid.Row="2" Spacing="6">
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=TwoWay}"
                Severity="Error"
                Title="Lỗi"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            <TextBlock
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
            <ProgressBar
                Height="4"
                Maximum="100"
                IsIndeterminate="False"
                Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- 4. Results list -->
        <ListView
            Grid.Row="3"
            x:Name="ResultsListView"
            ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
            SelectionMode="None"
            Padding="0,2">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:SearchHitRow">
                    <Border
                        Margin="0,4"
                        Padding="12"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="16">
                            <!-- Mod Icon -->
                            <Border
                                Grid.Column="0"
                                Width="48" Height="48"
                                CornerRadius="6"
                                Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <Image
                                    Width="48" Height="48"
                                    Stretch="UniformToFill"
                                    Source="{x:Bind IconUrl}"
                                    ImageFailed="IconImage_Failed" />
                            </Border>

                            <!-- Mod Info -->
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind Title}"
                                    FontWeight="SemiBold"
                                    FontSize="15"
                                    TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        Text="{x:Bind Author}"
                                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Text="•"
                                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Text="{x:Bind DownloadsText}"
                                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Text="downloads"
                                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                                <TextBlock
                                    Text="{x:Bind Description}"
                                    MaxLines="2"
                                    TextWrapping="Wrap"
                                    TextTrimming="CharacterEllipsis"
                                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Install Button -->
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="Install_Click"
                                DataContext="{x:Bind}"
                                IsEnabled="{Binding ElementName=RootDialog, Path=ViewModel.IsNotBusy, Mode=OneWay}"
                                Padding="12,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <SymbolIcon Symbol="Download" />
                                    <TextBlock Text="Cài" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <!-- 5. Load more -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button
                Content="Load more"
                Command="{x:Bind ViewModel.LoadMoreCommand}"
                Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
            <ProgressRing
                Width="20" Height="20"
                IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</ContentDialog>
