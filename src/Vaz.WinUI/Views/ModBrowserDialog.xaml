<ContentDialog
    x:Class="Vaz.WinUI.Views.ModBrowserDialog"
    x:Name="RootDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Vaz.WinUI.ViewModels"
    Title="Download Mods"
    CloseButtonText="Đóng"
    DefaultButton="Close"
    MaxWidth="820"
    MinWidth="720">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10" MinHeight="520">

        <!-- 1. Search bar -->
        <AutoSuggestBox
            Grid.Row="0"
            x:Name="SearchBox"
            PlaceholderText="Tìm mod trên Modrinth (ví dụ: sodium, iris, lithium)..."
            QueryIcon="Find"
            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
            TextChanged="SearchBox_TextChanged"
            QuerySubmitted="SearchBox_QuerySubmitted"
            HorizontalAlignment="Stretch" />

        <!-- 2. Filter row -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <ComboBox
                Header="Loader"
                ItemsSource="{x:Bind ViewModel.LoaderOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedLoader, Mode=TwoWay}"
                MinWidth="130" />
            <ComboBox
                Header="MC version"
                ItemsSource="{x:Bind ViewModel.VersionOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedGameVersion, Mode=TwoWay}"
                MinWidth="130" />
            <ComboBox
                Header="Sort"
                ItemsSource="{x:Bind ViewModel.SortOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}"
                MinWidth="130" />
            <CheckBox
                Content="Tải kèm dependencies"
                IsChecked="{x:Bind ViewModel.IncludeDependencies, Mode=TwoWay}"
                VerticalAlignment="Bottom"
                Margin="4,0,0,2" />
        </StackPanel>

        <!-- 3. Status / error / progress -->
        <StackPanel Grid.Row="2" Spacing="6">
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=TwoWay}"
                Severity="Error"
                Title="Lỗi"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            <TextBlock
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
            <Grid Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <ProgressBar
                    Height="4"
                    Maximum="100"
                    IsIndeterminate="False"
                    Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                    VerticalAlignment="Center"
                    Margin="0,0,70,0" />
                <Button
                    Content="Hủy"
                    Command="{x:Bind ViewModel.CancelInstallCommand}"
                    HorizontalAlignment="Right"
                    Padding="12,2"
                    FontSize="12" />
            </Grid>
        </StackPanel>

        <!-- 4. Results list -->
        <ListView
            Grid.Row="3"
            x:Name="ResultsListView"
            ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
            SelectionMode="None"
            Padding="0,2">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:SearchHitRow">
                    <Border
                        Margin="0,4"
                        Padding="12"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="16">
                            <!-- Mod Icon -->
                            <Border
                                Grid.Column="0"
                                Width="48" Height="48"
                                CornerRadius="6"
                                Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <Image
                                    Width="48" Height="48"
                                    Stretch="UniformToFill"
                                    Source="{x:Bind IconImageSource}"
                                    ImageFailed="IconImage_Failed" />
                            </Border>

                            <!-- Mod Info -->
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        Text="{x:Bind Title}"
                                        FontWeight="SemiBold"
                                        FontSize="15"
                                        TextTrimming="CharacterEllipsis" />
                                    <Border
                                        Visibility="{x:Bind IsInstalledVisibility}"
                                        Background="#059669"
                                        CornerRadius="4"
                                        Padding="6,1"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            Text="Đã cài"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="White" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        Text="{x:Bind Author}"
                                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Text="•"
                                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Text="{x:Bind DownloadsText}"
                                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Text="downloads"
                                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                                <TextBlock
                                    Text="{x:Bind Description}"
                                    MaxLines="2"
                                    TextWrapping="Wrap"
                                    TextTrimming="CharacterEllipsis"
                                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Install Button -->
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="Install_Click"
                                DataContext="{x:Bind}"
                                IsEnabled="{Binding ElementName=RootDialog, Path=ViewModel.IsNotBusy, Mode=OneWay}"
                                Padding="12,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <SymbolIcon Symbol="Download" />
                                    <TextBlock Text="Cài" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <!-- 5. Load more -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button
                Content="Load more"
                Command="{x:Bind ViewModel.LoadMoreCommand}"
                Visibility="{x:Bind ViewModel.HasMoreResults, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
            <ProgressRing
                Width="20" Height="20"
                IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}" />
        </StackPanel>

        <!-- 6. Dependency confirmation prompt overlay (MM-AC-04) -->
        <Grid
            x:Name="DependencyPromptOverlay"
            Grid.RowSpan="5"
            Background="#88000000"
            Visibility="Collapsed"
            Margin="-24"
            Padding="24"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="480"
                CornerRadius="12"
                Padding="24"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE7BA;" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="20" />
                        <TextBlock Text="Cài đặt kèm dependencies?" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>

                    <TextBlock
                        x:Name="DependencyPromptText"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        Text="Mod này yêu cầu các thư viện dependencies để hoạt động. Bạn có muốn cài đặt kèm toàn bộ dependencies?" />

                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Hủy" Click="CancelDependencyPrompt_Click" Padding="14,6" />
                        <Button
                            x:Name="ConfirmDependencyPromptButton"
                            Style="{StaticResource VazAccentButtonStyle}"
                            Content="Cài kèm dependencies"
                            Click="ConfirmDependencyPrompt_Click"
                            Padding="14,6" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ContentDialog>
