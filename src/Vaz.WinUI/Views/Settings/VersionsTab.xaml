<UserControl
    x:Class="Vaz.WinUI.Views.Settings.VersionsTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Vazer.Core.Versions"
    xmlns:vm="using:Vaz.WinUI.ViewModels">

    <Border Style="{StaticResource SettingsCardStyle}">
        <StackPanel Spacing="16">
            <!-- Header section: title + subtitle -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <FontIcon Glyph="&#xE8F1;" FontSize="24" Foreground="{StaticResource VazAccentBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Quản lý Phiên bản đã cài đặt" Style="{StaticResource SettingsSectionTitleStyle}" />
                    <TextBlock Text="Xem dung lượng, xóa các bản cài cũ hoặc dọn dẹp các phiên bản không còn sử dụng." Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- Stats bar + Action buttons -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xEC4A;" FontSize="16" Foreground="{StaticResource VazAccentBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="DiskUsageHeaderText"
                                   Text="{x:Bind ViewModel.DiskUsageHeader, Mode=OneWay}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="CleanupButton"
                                Click="Cleanup_Click"
                                ToolTipService.ToolTip="Xóa tất cả các phiên bản không có instance nào sử dụng">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                <TextBlock Text="Dọn dẹp" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RefreshButton"
                                Command="{x:Bind ViewModel.ScanVersionsCommand}"
                                ToolTipService.ToolTip="Quét lại danh sách phiên bản">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                <TextBlock Text="Làm mới" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status InfoBar -->
            <InfoBar x:Name="VersionsStatusInfoBar"
                     IsOpen="{x:Bind ViewModel.HasVersionsStatus, Mode=OneWay}"
                     Message="{x:Bind ViewModel.VersionsStatusText, Mode=OneWay}"
                     Severity="Informational"
                     IsClosable="True" />

            <!-- Table Header -->
            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8">
                <Grid ColumnDefinitions="200,100,100,140,*,Auto" ColumnSpacing="12">
                    <TextBlock Text="Phiên bản (ID)" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="Loại" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="Dung lượng" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="Ngày cài đặt" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="4" Text="Tình trạng sử dụng" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="5" Text="Thao tác" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Width="75" TextAlignment="Center" />
                </Grid>
            </Border>

            <!-- Versions ListView -->
            <ListView x:Name="VersionsListView"
                      ItemsSource="{x:Bind ViewModel.InstalledVersions, Mode=OneWay}"
                      SelectionMode="None"
                      MaxHeight="450">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:InstalledVersionInfo">
                        <Grid ColumnDefinitions="200,100,100,140,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                            <!-- Version ID -->
                            <TextBlock Text="{x:Bind VersionId}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind VersionId}" />

                            <!-- Loại -->
                            <Border Grid.Column="1"
                                    Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Type}"
                                           FontSize="11.5"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource VazAccentBrush}" />
                            </Border>

                            <!-- Dung lượng -->
                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind SizeDisplay}"
                                       FontSize="12.5"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <!-- Ngày cài đặt -->
                            <TextBlock Grid.Column="3"
                                       Text="{x:Bind InstalledAtDisplay}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <!-- Đang dùng bởi -->
                            <TextBlock Grid.Column="4"
                                       Text="{x:Bind UsageSummary}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind UsageSummary}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <!-- Nút Xóa -->
                            <Button Grid.Column="5"
                                    x:Name="DeleteVersionButton"
                                    Click="DeleteVersion_Click"
                                    IsEnabled="{x:Bind CanDelete}"
                                    ToolTipService.ToolTip="{x:Bind UsageSummary}"
                                    Width="75"
                                    Padding="8,4">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    <TextBlock Text="Xóa" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Loading & Empty state indicator -->
            <ProgressBar IsIndeterminate="True"
                         Visibility="{x:Bind ViewModel.IsScanningVersions, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Border>
</UserControl>
