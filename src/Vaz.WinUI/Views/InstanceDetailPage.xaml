<Page
    x:Class="Vaz.WinUI.Views.InstanceDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Vaz.WinUI.ViewModels"
    NavigationCacheMode="Required">

    <Grid x:Name="PageRoot" RowDefinitions="Auto,Auto,Auto,*" Padding="16,12,16,12" RowSpacing="8">

        <!-- Empty state: chưa có instance -->
        <StackPanel
            Grid.Row="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.HasInstance, Mode=OneWay, Converter={StaticResource BoolToVisInv}}">
            <FontIcon Glyph="&#xE7F8;" FontSize="32" />
            <TextBlock Text="Chưa chọn instance nào." HorizontalAlignment="Center" />
            <TextBlock
                Text="Chọn instance ở thanh bên trái."
                HorizontalAlignment="Center"
                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>

        <StackPanel
            Grid.Row="0"
            Grid.RowSpan="4"
            Spacing="8"
            Visibility="{x:Bind ViewModel.HasInstance, Mode=OneWay, Converter={StaticResource BoolToVis}}">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="2">
                    <TextBlock
                        Text="{x:Bind ViewModel.Current.Name, Mode=OneWay}"
                        FontSize="22"
                        FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.Current.MinecraftVersion, Mode=OneWay}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.LoaderDisplay, Mode=OneWay}"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                    </StackPanel>
                    <TextBlock
                        Text="{x:Bind ViewModel.LaunchStatus, Mode=OneWay}"
                        Foreground="{ThemeResource SystemAccentColor}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Content="Launch"
                    Command="{x:Bind ViewModel.LaunchCommand}"
                    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
            </Grid>

            <!-- Status / error -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=TwoWay}"
                Severity="Error"
                Title="Lỗi"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            <TextBlock
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
            <ProgressBar
                Height="4"
                Maximum="100"
                Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

            <!-- Tabs -->
            <TabView>
                <TabViewItem Header="Mods">
                    <TabViewItem.Content>
                        <Grid RowDefinitions="Auto,*" RowSpacing="8">
                            <!-- Toolbar -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                <Button Content="Check updates" Command="{x:Bind ViewModel.CheckUpdatesCommand}" />
                                <Button Content="Update all" Command="{x:Bind ViewModel.UpdateAllCommand}" />
                                <Button Content="Install .mrpack" Click="InstallMrpack_Click" />
                                <Button Content="Install OptiFine" Click="InstallOptifine_Click" />
                                <Button Content="Open mods folder" Command="{x:Bind ViewModel.OpenModsFolderCommand}" />
                                <InfoBar
                                    Severity="Informational"
                                    IsOpen="{x:Bind ViewModel.UpdateCount, Mode=OneWay, Converter={StaticResource CountToBool}}"
                                    Message="{x:Bind ViewModel.UpdateCount, Mode=OneWay, Converter={StaticResource CountToText}}" />
                            </StackPanel>

                            <!-- Mod list -->
                            <ListView
                                Grid.Row="1"
                                ItemsSource="{x:Bind ViewModel.Mods, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:InstalledModRow">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Padding="4">
                                            <FontIcon Grid.Column="0" Glyph="&#xE74C;" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                                <TextBlock Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Text="{x:Bind VersionId}"
                                                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{x:Bind UpdateBadge}"
                                                Foreground="{ThemeResource SystemAccentColor}"
                                                VerticalAlignment="Center" />
                                            <ToggleSwitch
                                                Grid.Column="3"
                                                IsOn="{x:Bind Enabled, Mode=OneWay}"
                                                Toggled="ModEnabled_Toggled" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </Grid>
                    </TabViewItem.Content>
                </TabViewItem>
                <TabViewItem Header="Settings">
                    <TabViewItem.Content>
                        <StackPanel MaxWidth="480" HorizontalAlignment="Left" Spacing="12" Padding="0,12,0,0">
                            <InfoBar
                                Severity="Warning"
                                IsOpen="True"
                                Title="RAM / JVM args"
                                Message="RAM / JVM args chưa có trong Core. Follow-up." />
                            <TextBlock Text="Thư mục instance:" FontWeight="SemiBold" />
                            <TextBox
                                IsReadOnly="True"
                                Text="{x:Bind ViewModel.FolderPath, Mode=OneWay}" />
                            <Button
                                Content="Delete instance"
                                Click="DeleteInstance_Click"
                                HorizontalAlignment="Left" />
                        </StackPanel>
                    </TabViewItem.Content>
                </TabViewItem>
            </TabView>
        </StackPanel>
    </Grid>
</Page>
