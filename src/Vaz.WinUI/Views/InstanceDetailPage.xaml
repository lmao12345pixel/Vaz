<Page
    x:Class="Vaz.WinUI.Views.InstanceDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Vaz.WinUI.ViewModels"
    xmlns:models="using:Vaz.WinUI.Models"
    xmlns:controls="using:Vaz.WinUI.Controls"
    KeyDown="Page_KeyDown"
    NavigationCacheMode="Disabled">

    <Page.Resources>
        <!-- Chip danh mục: mô phỏng .chip/.chip.is-active của web (accent-soft + accent border + accent text). -->
        <Style x:Key="CategoryChipStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="ChipBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ChipBorder.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ChipBorder.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="ChipBorder.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="ChipBorder.Background" Value="{StaticResource VazAccentSubtleBrush}" />
                                            <Setter Target="ChipBorder.BorderBrush" Value="{StaticResource VazAccentBrush}" />
                                            <Setter Target="ChipText.Foreground" Value="{StaticResource VazAccentBrush}" />
                                            <Setter Target="ChipText.FontWeight" Value="SemiBold" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                x:Name="ChipText"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid x:Name="PageRoot" RowDefinitions="Auto,Auto,*" Padding="24" RowSpacing="16">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
            <!-- Back Button -->
            <Button
                Grid.Column="0"
                Click="BackButton_Click"
                Background="Transparent"
                BorderThickness="0"
                Padding="8"
                CornerRadius="8"
                VerticalAlignment="Center"
                ToolTipService.ToolTip="Quay lại danh sách Instance">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>

            <!-- Title & Metadata Badges -->
            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                <TextBlock
                    Text="{x:Bind ViewModel.Current.Name, Mode=OneWay}"
                    FontSize="24"
                    FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,2">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE7F8;" FontSize="11" Foreground="{StaticResource VazAccentBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.Current.MinecraftVersion, Mode=OneWay}" FontSize="12" FontWeight="Medium" />
                        </StackPanel>
                    </Border>
                    <Border
                        Background="{StaticResource VazAccentSubtleBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,2">
                        <TextBlock
                            Text="{x:Bind ViewModel.LoaderDisplay, Mode=OneWay}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource VazAccentBrush}" />
                    </Border>
                    <TextBlock
                        Text="{x:Bind ViewModel.LaunchStatus, Mode=OneWay}"
                        Foreground="{StaticResource VazAccentBrush}"
                        FontSize="12"
                        FontWeight="Medium"
                        VerticalAlignment="Center"
                        Margin="4,0,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Launch Button -->
            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.LaunchCommand}"
                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                Style="{StaticResource VazAccentButtonStyle}"
                Padding="20,10"
                CornerRadius="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                    <TextBlock Text="Khởi chạy" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Status / error -->
        <StackPanel Grid.Row="1" Spacing="4">
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=TwoWay}"
                Severity="Error"
                Title="Lỗi"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            <TextBlock
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
            <ProgressBar
                Height="4"
                Maximum="100"
                Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- Tabs -->
        <TabView Grid.Row="2" IsAddTabButtonVisible="False" Margin="0,8,0,0">
            <TabViewItem IsClosable="False">
                <TabViewItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74C;" FontSize="14" Foreground="{StaticResource VazAccentBrush}" />
                        <TextBlock Text="Mods" FontWeight="Medium" />
                    </StackPanel>
                </TabViewItem.Header>
                <TabViewItem.Content>
                    <Grid x:Name="ModsContainerGrid"
                          ColumnDefinitions="*,Auto"
                          ColumnSpacing="16"
                          Padding="0,12,0,0"
                          AllowDrop="True"
                          DragOver="ModsGrid_DragOver"
                          Drop="ModsGrid_Drop">

                        <!-- Cột trái: Quản lý mod, Toolbar, Filter chips, Danh sách mod -->
                        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
                            <!-- Dependency Warning InfoBar (MM-AC-05) -->
                            <InfoBar
                                Grid.Row="0"
                                IsOpen="{x:Bind ViewModel.HasDependencyWarning, Mode=TwoWay}"
                                Severity="Warning"
                                Title="Cảnh báo Dependency"
                                Message="{x:Bind ViewModel.DependencyWarningMessage, Mode=OneWay}" />

                            <!-- Toolbar -->
                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <!-- Nhóm 1: Mod Management -->
                                    <Button Command="{x:Bind ViewModel.CheckUpdatesCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Sync" />
                                            <TextBlock Text="Check updates" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{x:Bind ViewModel.UpdateAllCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Download" />
                                            <TextBlock Text="Update all" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="DownloadMods_Click" Style="{StaticResource VazAccentButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Add" />
                                            <TextBlock Text="Download Mods" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="ImportJar_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                            <TextBlock Text="+ Thêm .jar" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Divider -->
                                    <Border Width="1" Height="24" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />

                                    <!-- Nhóm 2: Installers -->
                                    <Button Click="InstallMrpack_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Import" />
                                            <TextBlock Text="Install .mrpack" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="InstallOptifine_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Setting" />
                                            <TextBlock Text="Install OptiFine" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Divider -->
                                    <Border Width="1" Height="24" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />

                                    <!-- Nhóm 3: Utilities -->
                                    <Button Command="{x:Bind ViewModel.OpenModsFolderCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Folder" />
                                            <TextBlock Text="Open mods folder" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <InfoBar
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Severity="Informational"
                                    IsOpen="{x:Bind ViewModel.UpdateCount, Mode=OneWay, Converter={StaticResource CountToBool}}"
                                    Message="{x:Bind ViewModel.UpdateCount, Mode=OneWay, Converter={StaticResource CountToText}}" />
                            </Grid>

                            <!-- Category Chips Filter (MM-AC-03) -->
                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <controls:WrapPanel Grid.Column="0" VerticalSpacing="6" HorizontalSpacing="6">
                                    <RadioButton
                                        Content="Tất cả"
                                        Tag="all"
                                        GroupName="ModCategories"
                                        Style="{StaticResource CategoryChipStyle}"
                                        IsChecked="True"
                                        Checked="CategoryChip_Checked" />
                                    <RadioButton
                                        Content="Hiệu năng"
                                        Tag="performance"
                                        GroupName="ModCategories"
                                        Style="{StaticResource CategoryChipStyle}"
                                        Checked="CategoryChip_Checked" />
                                    <RadioButton
                                        Content="Đồ họa"
                                        Tag="graphics"
                                        GroupName="ModCategories"
                                        Style="{StaticResource CategoryChipStyle}"
                                        Checked="CategoryChip_Checked" />
                                    <RadioButton
                                        Content="Công nghệ"
                                        Tag="technology"
                                        GroupName="ModCategories"
                                        Style="{StaticResource CategoryChipStyle}"
                                        Checked="CategoryChip_Checked" />
                                    <RadioButton
                                        Content="Sinh tồn/QoL"
                                        Tag="survival"
                                        GroupName="ModCategories"
                                        Style="{StaticResource CategoryChipStyle}"
                                        Checked="CategoryChip_Checked" />
                                    <RadioButton
                                        Content="Phép thuật"
                                        Tag="magic"
                                        GroupName="ModCategories"
                                        Style="{StaticResource CategoryChipStyle}"
                                        Checked="CategoryChip_Checked" />
                                </controls:WrapPanel>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind ViewModel.ModSummaryText, Mode=OneWay}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0" />
                            </Grid>

                            <!-- Mod List (MM-AC-01, MM-AC-02) -->
                            <ListView
                                Grid.Row="3"
                                ItemsSource="{x:Bind ViewModel.FilteredMods, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:InstalledModRow">
                                        <Border
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,8"
                                            Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12">
                                                <!-- Mod Icon (Click opens inspector) -->
                                                <Button
                                                    Grid.Column="0"
                                                    Click="ModInspector_Click"
                                                    DataContext="{x:Bind}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    CornerRadius="6"
                                                    VerticalAlignment="Center">
                                                    <Border
                                                        Width="36" Height="36"
                                                        CornerRadius="6"
                                                        Background="{StaticResource VazAccentSubtleBrush}">
                                                        <Grid>
                                                            <Image
                                                                Source="{x:Bind IconUri}"
                                                                Width="32" Height="32"
                                                                Stretch="Uniform"
                                                                ImageFailed="ModIcon_Failed" />
                                                            <FontIcon
                                                                Glyph="&#xE74C;"
                                                                FontSize="16"
                                                                Foreground="{StaticResource VazAccentBrush}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </Button>

                                                <!-- Mod Info (Click opens inspector) -->
                                                <Button
                                                    Grid.Column="1"
                                                    Click="ModInspector_Click"
                                                    DataContext="{x:Bind}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    VerticalAlignment="Center">
                                                    <StackPanel Spacing="3">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock
                                                                Text="{x:Bind DisplayName}"
                                                                FontWeight="SemiBold"
                                                                FontSize="14"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <Border
                                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                                CornerRadius="4"
                                                                Padding="6,1"
                                                                VerticalAlignment="Center">
                                                                <TextBlock
                                                                    Text="{x:Bind CategoryLabel}"
                                                                    FontSize="11"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock
                                                                Text="{x:Bind Version}"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                FontSize="12" />
                                                            <TextBlock
                                                                Text="•"
                                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                FontSize="12" />
                                                            <TextBlock
                                                                Text="{x:Bind FileName}"
                                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                FontSize="12"
                                                                TextTrimming="CharacterEllipsis"
                                                                MaxWidth="200" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Badges (Warning & Update) -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <!-- Warning Badge (MM-AC-02) -->
                                                    <Border
                                                        Background="#33F59E0B"
                                                        BorderBrush="#F59E0B"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        Visibility="{x:Bind HasMissingDependencies, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                        ToolTipService.ToolTip="{x:Bind MissingDependenciesText, Mode=OneWay}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="&#xE7BA;" FontSize="11" Foreground="#F59E0B" />
                                                            <TextBlock
                                                                Text="Thiếu dependency"
                                                                Foreground="#F59E0B"
                                                                FontSize="11"
                                                                FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Update Badge -->
                                                    <Border
                                                        Background="{StaticResource VazAccentSubtleBrush}"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        Visibility="{x:Bind HasUpdate, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock
                                                            Text="{x:Bind UpdateBadge}"
                                                            Foreground="{StaticResource VazAccentBrush}"
                                                            FontSize="11"
                                                            FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>

                                                <!-- ToggleSwitch -->
                                                <ToggleSwitch
                                                    Grid.Column="3"
                                                    IsOn="{x:Bind Enabled, Mode=OneWay}"
                                                    Toggled="ModEnabled_Toggled"
                                                    OffContent=""
                                                    OnContent=""
                                                    MinWidth="0"
                                                    VerticalAlignment="Center" />

                                                <!-- Delete / Action Button -->
                                                <Button
                                                    Grid.Column="4"
                                                    Click="UninstallMod_Click"
                                                    DataContext="{x:Bind}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="6"
                                                    CornerRadius="4"
                                                    VerticalAlignment="Center"
                                                    ToolTipService.ToolTip="Gỡ cài đặt mod">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </Grid>

                        <!-- Cột phải: Mod Inspector Drawer (MM-AC-01, MM-AC-02, MM-AC-07) -->
                        <Border
                            Grid.Column="1"
                            Width="360"
                            Visibility="{x:Bind ViewModel.IsInspectorOpen, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="16">
                                    <!-- Inspector Header: Icon, Title, Close Button -->
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border
                                            Grid.Column="0"
                                            Width="48" Height="48"
                                            CornerRadius="8"
                                            Background="{StaticResource VazAccentSubtleBrush}">
                                            <Grid>
                                                <Image
                                                    Source="{x:Bind ViewModel.SelectedModForInspector.IconUri, Mode=OneWay}"
                                                    Width="40" Height="40"
                                                    Stretch="Uniform" />
                                                <FontIcon
                                                    Glyph="&#xE74C;"
                                                    FontSize="20"
                                                    Foreground="{StaticResource VazAccentBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock
                                                Text="{x:Bind ViewModel.SelectedModForInspector.DisplayName, Mode=OneWay}"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.SelectedModForInspector.Author, Mode=OneWay}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                FontSize="12" />
                                        </StackPanel>

                                        <Button
                                            Grid.Column="2"
                                            Command="{x:Bind ViewModel.CloseInspectorCommand}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="8"
                                            CornerRadius="6"
                                            VerticalAlignment="Top"
                                            ToolTipService.ToolTip="Đóng (Esc)">
                                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                                        </Button>
                                    </Grid>

                                    <!-- Metadata Badges -->
                                    <controls:WrapPanel VerticalSpacing="6" HorizontalSpacing="6">
                                        <!-- Category Badge -->
                                        <Border
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="6"
                                            Padding="8,3">
                                            <TextBlock
                                                Text="{x:Bind ViewModel.SelectedModForInspector.CategoryLabel, Mode=OneWay}"
                                                FontSize="11"
                                                FontWeight="Medium"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>

                                        <!-- Loader Badge -->
                                        <Border
                                            Background="{StaticResource VazAccentSubtleBrush}"
                                            CornerRadius="6"
                                            Padding="8,3">
                                            <TextBlock
                                                Text="{x:Bind ViewModel.SelectedModForInspector.Loader, Mode=OneWay}"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource VazAccentBrush}" />
                                        </Border>

                                        <!-- MC Version Badge -->
                                        <Border
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="6"
                                            Padding="8,3">
                                            <TextBlock
                                                Text="{x:Bind ViewModel.SelectedModForInspector.MinecraftVersion, Mode=OneWay}"
                                                FontSize="11"
                                                FontWeight="Medium" />
                                        </Border>

                                        <!-- Version Badge -->
                                        <Border
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="6"
                                            Padding="8,3">
                                            <TextBlock
                                                Text="{x:Bind ViewModel.SelectedModForInspector.Version, Mode=OneWay}"
                                                FontSize="11"
                                                FontWeight="Medium" />
                                        </Border>
                                    </controls:WrapPanel>

                                    <!-- Description -->
                                    <TextBlock
                                        Text="{x:Bind ViewModel.SelectedModForInspector.Description, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        FontSize="13"
                                        LineHeight="18"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    <!-- File Name -->
                                    <Border
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,6">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Tên tệp:" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.SelectedModForInspector.FileName, Mode=OneWay}"
                                                FontFamily="Consolas"
                                                FontSize="12"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>

                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                    <!-- Dependency Section (MM-AC-02) -->
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Dependencies" FontSize="14" FontWeight="SemiBold" />

                                        <!-- Status text -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon
                                                Glyph="&#xE7BA;"
                                                FontSize="13"
                                                Foreground="#F59E0B"
                                                Visibility="{x:Bind ViewModel.InspectorDepStatusIsWarning, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                            <FontIcon
                                                Glyph="&#xE73E;"
                                                FontSize="13"
                                                Foreground="{StaticResource VazAccentBrush}"
                                                Visibility="{x:Bind ViewModel.InspectorDepStatusIsWarning, Mode=OneWay, Converter={StaticResource BoolToVisInv}}" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.InspectorDepStatus, Mode=OneWay}"
                                                FontSize="13"
                                                FontWeight="Medium" />
                                        </StackPanel>

                                        <!-- 1-Click Resolve Button (MM-AC-02) -->
                                        <Button
                                            Content="{x:Bind ViewModel.InspectorDepActionText, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.ResolveInspectorDependenciesCommand}"
                                            Visibility="{x:Bind ViewModel.InspectorDepActionVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                            Style="{StaticResource VazAccentButtonStyle}"
                                            HorizontalAlignment="Stretch" />

                                        <!-- Dependencies Items List -->
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.InspectorDependencies, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:ModDependencyStatusItem">
                                                    <Border
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="10,6"
                                                        Margin="0,0,0,6">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <StackPanel Grid.Column="0" Spacing="2">
                                                                <TextBlock Text="{x:Bind Name}" FontWeight="Medium" FontSize="13" />
                                                                <TextBlock Text="{x:Bind RequiredBy}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                            </StackPanel>
                                                            <Border
                                                                Grid.Column="1"
                                                                Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                                                CornerRadius="4"
                                                                Padding="6,2"
                                                                VerticalAlignment="Center">
                                                                <TextBlock
                                                                    Text="{x:Bind StatusText}"
                                                                    FontSize="11"
                                                                    FontWeight="SemiBold" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                    <!-- External Links -->
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <HyperlinkButton
                                            Content="Modrinth"
                                            NavigateUri="{x:Bind ViewModel.SelectedModForInspector.ProjectUrl, Mode=OneWay}" />
                                        <HyperlinkButton
                                            Content="Mã nguồn (Source)"
                                            NavigateUri="{x:Bind ViewModel.SelectedModForInspector.SourceUrl, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabViewItem.Content>
            </TabViewItem>
            <TabViewItem IsClosable="False">
                <TabViewItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE756;" FontSize="14" Foreground="{StaticResource VazAccentBrush}" />
                        <TextBlock Text="Logs &amp; Console" FontWeight="Medium" />
                    </StackPanel>
                </TabViewItem.Header>
                <TabViewItem.Content>
                        <Grid RowDefinitions="Auto,*" RowSpacing="12" Padding="0,12,0,0">
                            <!-- Toolbar -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                <Button Click="ClearLog_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <SymbolIcon Symbol="Clear" />
                                        <TextBlock Text="Clear Log" />
                                    </StackPanel>
                                </Button>
                                <Button Click="CopyLog_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <SymbolIcon Symbol="Copy" />
                                        <TextBlock Text="Copy to Clipboard" />
                                    </StackPanel>
                                </Button>
                                <CheckBox
                                    Content="Auto-scroll"
                                    IsChecked="{x:Bind ViewModel.AutoScroll, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Log Content -->
                            <Grid Grid.Row="1" MinHeight="260">
                                <!-- Empty state when no logs -->
                                <StackPanel
                                    Visibility="{x:Bind ViewModel.HasLogs, Mode=OneWay, Converter={StaticResource BoolToVisInv}}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                                    <FontIcon Glyph="&#xE9F9;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock
                                        Text="Chưa có log nào. Bấm Launch để bắt đầu."
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        HorizontalAlignment="Center" />
                                </StackPanel>

                                <!-- Log Viewer -->
                                <ScrollViewer
                                    x:Name="LogScrollViewer"
                                    Visibility="{x:Bind ViewModel.HasLogs, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12"
                                    HorizontalScrollBarVisibility="Auto"
                                    VerticalScrollBarVisibility="Auto">
                                    <TextBox
                                        x:Name="LogTextBox"
                                        IsReadOnly="True"
                                        Text="{x:Bind ViewModel.LogText, Mode=OneWay}"
                                        FontFamily="Consolas, Cascadia Mono, monospace"
                                        FontSize="12"
                                        AcceptsReturn="True"
                                        TextWrapping="NoWrap"
                                        BorderThickness="0"
                                        Background="Transparent" />
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </TabViewItem.Content>
                </TabViewItem>
            <TabViewItem IsClosable="False">
                <TabViewItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="{StaticResource VazAccentBrush}" />
                        <TextBlock Text="Cấu hình Game (options.txt)" FontWeight="Medium" />
                    </StackPanel>
                </TabViewItem.Header>
                    <TabViewItem.Content>
                        <Grid RowDefinitions="Auto,*" RowSpacing="12" Padding="0,12,0,0">
                            <!-- Toolbar -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                <Button
                                    Command="{x:Bind ViewModel.SaveGameOptionsCommand}"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <SymbolIcon Symbol="Save" />
                                        <TextBlock Text="Lưu cấu hình" />
                                    </StackPanel>
                                </Button>

                                <DropDownButton Content="Cấu hình sẵn">
                                    <DropDownButton.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Tối ưu FPS" Click="PresetPerformance_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE7E8;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Cân bằng" Click="PresetBalanced_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE9F5;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Đồ họa cao" Click="PresetHighQuality_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE734;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>

                                <Button Click="ExportOptions_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <SymbolIcon Symbol="Share" />
                                        <TextBlock Text="Xuất file options.txt" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{x:Bind ViewModel.OpenInstanceFolderCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <SymbolIcon Symbol="Folder" />
                                        <TextBlock Text="Mở thư mục" />
                                    </StackPanel>
                                </Button>

                                <Border Width="1" Height="24" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />

                                <ToggleSwitch
                                    OffContent="Visual"
                                    OnContent="Raw"
                                    IsOn="{x:Bind ViewModel.IsRawViewMode, Mode=OneWay}"
                                    Toggled="ViewMode_Toggled"
                                    VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Nội dung Visual Editor -->
                            <ScrollViewer
                                Grid.Row="1"
                                Visibility="{x:Bind ViewModel.IsRawViewMode, Mode=OneWay, Converter={StaticResource BoolToVisInv}}"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left" Padding="0,0,16,16">
                                    <!-- Card Đồ họa -->
                                    <Border
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Đồ họa (Graphics)" FontSize="16" FontWeight="SemiBold" />

                                            <Slider
                                                Header="Khoảng cách hiển thị (Render distance - chunks)"
                                                Minimum="2" Maximum="32" StepFrequency="1"
                                                Value="{x:Bind ViewModel.GameOptions.RenderDistance, Mode=TwoWay, Converter={StaticResource DoubleToInt}}" />

                                            <Slider
                                                Header="Khoảng cách mô phỏng (Simulation distance - chunks)"
                                                Minimum="2" Maximum="32" StepFrequency="1"
                                                Value="{x:Bind ViewModel.GameOptions.SimulationDistance, Mode=TwoWay, Converter={StaticResource DoubleToInt}}" />

                                            <Slider
                                                Header="Giới hạn FPS (Max FPS)"
                                                Minimum="10" Maximum="260" StepFrequency="10"
                                                Value="{x:Bind ViewModel.GameOptions.MaxFps, Mode=TwoWay, Converter={StaticResource DoubleToInt}}" />

                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Chế độ đồ họa (Graphics Mode)" Style="{StaticResource CaptionTextBlockStyle}" />
                                                <ComboBox x:Name="GraphicsModeComboBox" SelectionChanged="GraphicsMode_SelectionChanged" Width="200">
                                                    <ComboBoxItem Content="Fast (Tối ưu)" Tag="fast" />
                                                    <ComboBoxItem Content="Fancy (Mặc định)" Tag="fancy" />
                                                    <ComboBoxItem Content="Fabulous (Rực rỡ)" Tag="fabulous" />
                                                </ComboBox>
                                            </StackPanel>

                                            <Slider
                                                Header="Độ sáng (Gamma / Brightness)"
                                                Minimum="0.0" Maximum="1.0" StepFrequency="0.05"
                                                Value="{x:Bind ViewModel.GameOptions.Gamma, Mode=TwoWay}" />

                                            <Slider
                                                Header="Tỉ lệ giao diện (GUI Scale - 0 là Auto)"
                                                Minimum="0" Maximum="4" StepFrequency="1"
                                                Value="{x:Bind ViewModel.GameOptions.GuiScale, Mode=TwoWay, Converter={StaticResource DoubleToInt}}" />

                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                                <ToggleSwitch Header="Đồng bộ dọc (V-Sync)" IsOn="{x:Bind ViewModel.GameOptions.EnableVsync, Mode=TwoWay}" />
                                                <ToggleSwitch Grid.Column="1" Header="Bóng thực thể (Shadows)" IsOn="{x:Bind ViewModel.GameOptions.EntityShadows, Mode=TwoWay}" />
                                                <ToggleSwitch Grid.Column="2" Header="Mây trời (Clouds)" IsOn="{x:Bind ViewModel.GameOptions.RenderClouds, Mode=TwoWay}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card Âm thanh -->
                                    <Border
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Âm thanh (Audio)" FontSize="16" FontWeight="SemiBold" />

                                            <Slider
                                                Header="Âm lượng tổng (Master Volume)"
                                                Minimum="0.0" Maximum="1.0" StepFrequency="0.01"
                                                Value="{x:Bind ViewModel.GameOptions.SoundCategoryMaster, Mode=TwoWay}" />

                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                                <Slider
                                                    Header="Nhạc nền (Music)"
                                                    Minimum="0.0" Maximum="1.0" StepFrequency="0.01"
                                                    Value="{x:Bind ViewModel.GameOptions.SoundCategoryMusic, Mode=TwoWay}" />
                                                <Slider
                                                    Grid.Column="1"
                                                    Header="Thời tiết (Weather)"
                                                    Minimum="0.0" Maximum="1.0" StepFrequency="0.01"
                                                    Value="{x:Bind ViewModel.GameOptions.SoundCategoryWeather, Mode=TwoWay}" />
                                                <Slider
                                                    Grid.Row="1"
                                                    Header="Khối / Địa hình (Blocks)"
                                                    Minimum="0.0" Maximum="1.0" StepFrequency="0.01"
                                                    Value="{x:Bind ViewModel.GameOptions.SoundCategoryBlock, Mode=TwoWay}" />
                                                <Slider
                                                    Grid.Row="1" Grid.Column="1"
                                                    Header="Quái vật hung dữ (Hostile)"
                                                    Minimum="0.0" Maximum="1.0" StepFrequency="0.01"
                                                    Value="{x:Bind ViewModel.GameOptions.SoundCategoryHostile, Mode=TwoWay}" />
                                                <Slider
                                                    Grid.Row="2"
                                                    Header="Người chơi (Players)"
                                                    Minimum="0.0" Maximum="1.0" StepFrequency="0.01"
                                                    Value="{x:Bind ViewModel.GameOptions.SoundCategoryPlayer, Mode=TwoWay}" />
                                                <Slider
                                                    Grid.Row="2" Grid.Column="1"
                                                    Header="Môi trường (Ambient)"
                                                    Minimum="0.0" Maximum="1.0" StepFrequency="0.01"
                                                    Value="{x:Bind ViewModel.GameOptions.SoundCategoryAmbient, Mode=TwoWay}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card Điều khiển -->
                                    <Border
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Điều khiển (Controls)" FontSize="16" FontWeight="SemiBold" />

                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                                <Slider
                                                    Header="Độ nhạy chuột (Mouse Sensitivity)"
                                                    Minimum="0.0" Maximum="1.0" StepFrequency="0.01"
                                                    Value="{x:Bind ViewModel.GameOptions.MouseSensitivity, Mode=TwoWay}" />
                                                <Slider
                                                    Grid.Column="1"
                                                    Header="Góc nhìn (FOV)"
                                                    Minimum="30.0" Maximum="110.0" StepFrequency="1.0"
                                                    Value="{x:Bind ViewModel.GameOptions.Fov, Mode=TwoWay}" />
                                            </Grid>

                                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                                                <ToggleSwitch Header="Đảo ngược chuột Y" IsOn="{x:Bind ViewModel.GameOptions.InvertYMouse, Mode=TwoWay}" />
                                                <ToggleSwitch Grid.Column="1" Header="Tự động nhảy" IsOn="{x:Bind ViewModel.GameOptions.AutoJump, Mode=TwoWay}" />
                                                <ToggleSwitch Grid.Column="2" Header="Toggle Sneak" IsOn="{x:Bind ViewModel.GameOptions.SneakToggle, Mode=TwoWay}" />
                                                <ToggleSwitch Grid.Column="3" Header="Toggle Sprint" IsOn="{x:Bind ViewModel.GameOptions.SprintToggle, Mode=TwoWay}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card Instance Info / Delete -->
                                    <Border
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Thư mục &amp; Quản trị Instance" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="Đường dẫn thư mục:" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBox IsReadOnly="True" Text="{x:Bind ViewModel.FolderPath, Mode=OneWay}" />
                                            <Button
                                                Content="Xóa instance"
                                                Click="DeleteInstance_Click"
                                                HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Nội dung Raw Editor -->
                            <Grid
                                Grid.Row="1"
                                Visibility="{x:Bind ViewModel.IsRawViewMode, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                MinHeight="360">
                                <TextBox
                                    Text="{x:Bind ViewModel.RawOptionsText, Mode=TwoWay}"
                                    AcceptsReturn="True"
                                    TextWrapping="NoWrap"
                                    FontFamily="Cascadia Code, Consolas, monospace"
                                    FontSize="13"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                            </Grid>
                        </Grid>
                    </TabViewItem.Content>
                </TabViewItem>
            </TabView>
    </Grid>
</Page>
