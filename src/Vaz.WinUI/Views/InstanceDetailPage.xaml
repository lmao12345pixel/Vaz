<Page
    x:Class="Vaz.WinUI.Views.InstanceDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Vaz.WinUI.ViewModels"
    NavigationCacheMode="Disabled">

    <Grid x:Name="PageRoot" RowDefinitions="Auto,Auto,Auto,*" Padding="24" RowSpacing="16">

        <StackPanel
            Grid.Row="0"
            Grid.RowSpan="4"
            Spacing="16">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="4">
                    <TextBlock
                        Text="{x:Bind ViewModel.Current.Name, Mode=OneWay}"
                        FontSize="28"
                        FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.Current.MinecraftVersion, Mode=OneWay}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.LoaderDisplay, Mode=OneWay}"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                    </StackPanel>
                    <TextBlock
                        Text="{x:Bind ViewModel.LaunchStatus, Mode=OneWay}"
                        Foreground="{ThemeResource SystemAccentColor}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Content="Launch"
                    Command="{x:Bind ViewModel.LaunchCommand}"
                    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
            </Grid>

            <!-- Status / error -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=TwoWay}"
                Severity="Error"
                Title="Lỗi"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            <TextBlock
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
            <ProgressBar
                Height="4"
                Maximum="100"
                Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

            <!-- Tabs -->
            <TabView IsAddTabButtonVisible="False" Margin="0,8,0,0">
                <TabViewItem Header="Mods" IsClosable="False">
                    <TabViewItem.Content>
                        <Grid RowDefinitions="Auto,*" RowSpacing="12" Padding="0,12,0,0">
                            <!-- Toolbar -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                <!-- Nhóm 1: Mod Management -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Command="{x:Bind ViewModel.CheckUpdatesCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Sync" />
                                            <TextBlock Text="Check updates" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{x:Bind ViewModel.UpdateAllCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Download" />
                                            <TextBlock Text="Update all" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="DownloadMods_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Add" />
                                            <TextBlock Text="Download Mods" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Divider -->
                                <Border Width="1" Height="24" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />

                                <!-- Nhóm 2: Installers -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Click="InstallMrpack_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Import" />
                                            <TextBlock Text="Install .mrpack" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="InstallOptifine_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Setting" />
                                            <TextBlock Text="Install OptiFine" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Divider -->
                                <Border Width="1" Height="24" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />

                                <!-- Nhóm 3: Utilities -->
                                <Button Command="{x:Bind ViewModel.OpenModsFolderCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <SymbolIcon Symbol="Folder" />
                                        <TextBlock Text="Open mods folder" />
                                    </StackPanel>
                                </Button>

                                <InfoBar
                                    Severity="Informational"
                                    IsOpen="{x:Bind ViewModel.UpdateCount, Mode=OneWay, Converter={StaticResource CountToBool}}"
                                    Message="{x:Bind ViewModel.UpdateCount, Mode=OneWay, Converter={StaticResource CountToText}}" />
                            </StackPanel>

                            <!-- Mod list -->
                            <ListView
                                Grid.Row="1"
                                ItemsSource="{x:Bind ViewModel.Mods, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:InstalledModRow">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Padding="4">
                                            <FontIcon Grid.Column="0" Glyph="&#xE74C;" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                                <TextBlock Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Text="{x:Bind VersionId}"
                                                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{x:Bind UpdateBadge}"
                                                Foreground="{ThemeResource SystemAccentColor}"
                                                VerticalAlignment="Center" />
                                            <ToggleSwitch
                                                Grid.Column="3"
                                                IsOn="{x:Bind Enabled, Mode=OneWay}"
                                                Toggled="ModEnabled_Toggled" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </Grid>
                    </TabViewItem.Content>
                </TabViewItem>
                <TabViewItem Header="Settings" IsClosable="False">
                    <TabViewItem.Content>
                        <StackPanel MaxWidth="480" HorizontalAlignment="Left" Spacing="12" Padding="0,12,0,0">
                            <InfoBar
                                Severity="Warning"
                                IsOpen="True"
                                Title="RAM / JVM args"
                                Message="RAM / JVM args chưa có trong Core. Follow-up." />
                            <TextBlock Text="Thư mục instance:" FontWeight="SemiBold" />
                            <TextBox
                                IsReadOnly="True"
                                Text="{x:Bind ViewModel.FolderPath, Mode=OneWay}" />
                            <Button
                                Content="Delete instance"
                                Click="DeleteInstance_Click"
                                HorizontalAlignment="Left" />
                        </StackPanel>
                    </TabViewItem.Content>
                </TabViewItem>
            </TabView>
        </StackPanel>
    </Grid>
</Page>
