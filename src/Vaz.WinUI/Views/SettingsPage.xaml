<Page
    x:Class="Vaz.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Vaz.WinUI.Controls"
    xmlns:vm="using:Vaz.WinUI.ViewModels">

    <Page.Resources>
        <!-- Card = surfaceElevated + stroke + radius.md (12) + spacing.md (16) từ docs/design/tokens.json -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource VazRadiusMd}" />
            <Setter Property="Padding" Value="{StaticResource VazPaddingMd}" />
        </Style>
        <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SpecLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Chip danh mục: mô phỏng .chip/.chip.is-active của web (accent-soft + accent border + accent text). -->
        <Style x:Key="CategoryChipStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="ChipBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ChipBorder.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ChipBorder.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="ChipBorder.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="ChipBorder.Background" Value="{StaticResource VazAccentSubtleBrush}" />
                                            <Setter Target="ChipBorder.BorderBrush" Value="{StaticResource VazAccentBrush}" />
                                            <Setter Target="ChipText.Foreground" Value="{StaticResource VazAccentBrush}" />
                                            <Setter Target="ChipText.FontWeight" Value="SemiBold" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                x:Name="ChipText"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource VazPaddingLg}" RowSpacing="16" RowDefinitions="Auto,Auto,*,Auto">

        <!-- Header: title + subtitle + actions -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="Cài đặt" FontSize="28" FontWeight="SemiBold" />
                <TextBlock
                    Text="Cấu hình toàn diện launcher, môi trường Java, giao diện và hiệu năng."
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button
                    Style="{StaticResource VazAccentButtonStyle}"
                    Command="{x:Bind ViewModel.SaveCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74E;" FontSize="13" />
                        <TextBlock Text="Lưu cài đặt" />
                    </StackPanel>
                </Button>
                <Button Click="Reset_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE777;" FontSize="13" />
                        <TextBlock Text="Mặc định" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Category chips (SET-AC-01); web dùng flex-wrap nên app wrap khi cửa sổ hẹp (SET-AC-11) -->
        <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.Categories}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SettingsOption">
                    <RadioButton
                        Content="{x:Bind Label}"
                        Tag="{x:Bind Value}"
                        GroupName="SettingsCategory"
                        Style="{StaticResource CategoryChipStyle}"
                        Loaded="CategoryChip_Loaded"
                        Checked="CategoryChip_Checked" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Sections -->
        <ScrollViewer
            Grid.Row="2"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" MaxWidth="1000" HorizontalAlignment="Left" Padding="0,0,16,0">

                <!-- 1. Khởi chạy & Hệ thống -->
                <Border
                    Style="{StaticResource SettingsCardStyle}"
                    Visibility="{x:Bind ViewModel.SelectedCategoryKey, Mode=OneWay, Converter={StaticResource SettingsSectionVis}, ConverterParameter=launcher}">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <FontIcon Glyph="&#xE770;" FontSize="20" Foreground="{StaticResource VazAccentBrush}" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Khởi chạy &amp; Hệ thống" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <TextBlock Text="Hành vi ứng dụng khi chạy game và tắt cửa sổ." Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <ComboBox
                            Header="Ngôn ngữ hiển thị"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.Languages}"
                            SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SettingsOption">
                                    <TextBlock Text="{x:Bind Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <ComboBox
                            Header="Khi Minecraft khởi chạy"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.LaunchActions}"
                            SelectedItem="{x:Bind ViewModel.SelectedLaunchAction, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SettingsOption">
                                    <TextBlock Text="{x:Bind Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <ToggleSwitch
                            Header="Thu nhỏ vào khay hệ thống (System Tray) khi bấm nút đóng [X]"
                            IsOn="{x:Bind ViewModel.CloseToTray, Mode=TwoWay}" />
                        <ToggleSwitch
                            Header="Tự động kiểm tra bản cập nhật V.A.Z khi mở ứng dụng"
                            IsOn="{x:Bind ViewModel.AutoCheckUpdates, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!-- 2. Java & Bộ nhớ RAM -->
                <Border
                    Style="{StaticResource SettingsCardStyle}"
                    Visibility="{x:Bind ViewModel.SelectedCategoryKey, Mode=OneWay, Converter={StaticResource SettingsSectionVis}, ConverterParameter=java}">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <FontIcon Glyph="&#xE950;" FontSize="20" Foreground="{StaticResource VazAccentBrush}" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Java &amp; Bộ nhớ RAM" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <TextBlock Text="Áp dụng mặc định cho instance mới và tinh chỉnh JVM." Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox
                                Header="Đường dẫn Java Runtime"
                                PlaceholderText="Tự động phát hiện"
                                Text="{x:Bind ViewModel.JavaPath, Mode=TwoWay}" />
                            <Button
                                Grid.Column="1"
                                Content="Dò Java"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.DetectJavaCommand}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <Slider
                                Header="RAM tối thiểu (Xms)"
                                Minimum="1024" Maximum="8192" StepFrequency="512" SmallChange="512"
                                SnapsTo="StepValues"
                                Value="{x:Bind ViewModel.MinRamMb, Mode=TwoWay, Converter={StaticResource DoubleToInt}}" />
                            <NumberBox
                                Grid.Column="1"
                                MinWidth="120"
                                VerticalAlignment="Bottom"
                                Minimum="1024" Maximum="8192"
                                SmallChange="512" SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.MinRamMb, Mode=TwoWay, Converter={StaticResource DoubleToInt}}" />
                            <TextBlock Grid.Column="2" Text="MB" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <Slider
                                Header="RAM tối đa mặc định (Xmx)"
                                Minimum="1024" Maximum="16384" StepFrequency="512" SmallChange="512"
                                SnapsTo="StepValues"
                                Value="{x:Bind ViewModel.RamMb, Mode=TwoWay, Converter={StaticResource DoubleToInt}}" />
                            <NumberBox
                                Grid.Column="1"
                                MinWidth="120"
                                VerticalAlignment="Bottom"
                                Minimum="1024" Maximum="16384"
                                SmallChange="512" SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.RamMb, Mode=TwoWay, Converter={StaticResource DoubleToInt}}" />
                            <TextBlock Grid.Column="2" Text="MB" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                        </Grid>

                        <ComboBox
                            Header="Preset cờ tối ưu JVM"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.JvmPresets}"
                            SelectedItem="{x:Bind ViewModel.SelectedJvmPreset, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SettingsOption">
                                    <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBox
                            Header="Cờ JVM bổ sung (Arguments)"
                            FontFamily="Consolas"
                            PlaceholderText="-XX:+UseG1GC -XX:+UnlockExperimentalVMOptions"
                            Text="{x:Bind ViewModel.JvmArgs, Mode=TwoWay}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <NumberBox
                                Header="Chiều rộng cửa sổ"
                                Minimum="640" Maximum="3840" SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.WindowWidth, Mode=TwoWay, Converter={StaticResource DoubleToInt}}" />
                            <NumberBox
                                Grid.Column="1"
                                Header="Chiều cao cửa sổ"
                                Minimum="480" Maximum="2160" SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.WindowHeight, Mode=TwoWay, Converter={StaticResource DoubleToInt}}" />
                        </Grid>

                        <ToggleSwitch
                            Header="Khởi động game ở chế độ toàn màn hình (Fullscreen)"
                            IsOn="{x:Bind ViewModel.StartFullscreen, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!-- 3. Giao diện & Trải nghiệm -->
                <Border
                    Style="{StaticResource SettingsCardStyle}"
                    Visibility="{x:Bind ViewModel.SelectedCategoryKey, Mode=OneWay, Converter={StaticResource SettingsSectionVis}, ConverterParameter=appearance}">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <FontIcon Glyph="&#xE790;" FontSize="20" Foreground="{StaticResource VazAccentBrush}" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Giao diện &amp; Trải nghiệm" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <TextBlock Text="Chủ đề màu, hiệu ứng chuyển động và âm thanh xúc giác." Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <ComboBox
                            Header="Giao diện chính (Theme)"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.Themes}"
                            SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SettingsOption">
                                    <TextBlock Text="{x:Bind Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Màu sắc chủ đạo (Accent Color)" Style="{StaticResource CaptionTextBlockStyle}" />
                            <ListView
                                ItemsSource="{x:Bind ViewModel.Accents}"
                                SelectedItem="{x:Bind ViewModel.SelectedAccent, Mode=TwoWay}"
                                SelectionMode="Single"
                                MaxHeight="64"
                                ScrollViewer.HorizontalScrollMode="Enabled"
                                ScrollViewer.VerticalScrollMode="Disabled"
                                ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsStackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="MinWidth" Value="0" />
                                        <Setter Property="Padding" Value="8,4" />
                                        <Setter Property="Margin" Value="0,0,4,0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SettingsOption">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Ellipse
                                                Width="18" Height="18"
                                                Fill="{x:Bind ColorHex, Converter={StaticResource AccentHexToBrush}}" />
                                            <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <ToggleSwitch
                            Header="Giảm chuyển động (Tắt hoạt ảnh trượt &amp; lò xo theo accessibility)"
                            IsOn="{x:Bind ViewModel.ReduceMotion, Mode=TwoWay}" />
                        <ToggleSwitch
                            Header="Phát âm thanh click xúc giác Minecraft khi tương tác"
                            IsOn="{x:Bind ViewModel.UiSoundEnabled, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!-- 4. Mạng & Tải xuống -->
                <Border
                    Style="{StaticResource SettingsCardStyle}"
                    Visibility="{x:Bind ViewModel.SelectedCategoryKey, Mode=OneWay, Converter={StaticResource SettingsSectionVis}, ConverterParameter=network}">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <FontIcon Glyph="&#xE896;" FontSize="20" Foreground="{StaticResource VazAccentBrush}" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Mạng &amp; Tải xuống" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <TextBlock Text="Tốc độ tải modpack, texture pack và máy chủ CDN." Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <ComboBox
                            Header="Số luồng tải đồng thời"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.ThreadOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedDownloadThreads, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SettingsOption">
                                    <TextBlock Text="{x:Bind Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <ComboBox
                            Header="Máy chủ CDN tải modpack &amp; asset"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.Mirrors}"
                            SelectedItem="{x:Bind ViewModel.SelectedMirror, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SettingsOption">
                                    <TextBlock Text="{x:Bind Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <ComboBox
                            Header="Giới hạn băng thông tải xuống"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.BandwidthOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedBandwidth, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SettingsOption">
                                    <TextBlock Text="{x:Bind Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- 5. Discord & Riêng tư -->
                <Border
                    Style="{StaticResource SettingsCardStyle}"
                    Visibility="{x:Bind ViewModel.SelectedCategoryKey, Mode=OneWay, Converter={StaticResource SettingsSectionVis}, ConverterParameter=discord}">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <FontIcon Glyph="&#xE717;" FontSize="20" Foreground="{StaticResource VazAccentBrush}" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Discord &amp; Riêng tư" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <TextBlock Text="Mô phỏng trạng thái hoạt động trên Discord khi chơi game." Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <ToggleSwitch
                            Header="Kích hoạt Discord Rich Presence"
                            IsOn="{x:Bind ViewModel.DiscordRpc, Mode=TwoWay}" />
                        <TextBox
                            Header="Trạng thái tùy biến in-game"
                            PlaceholderText="VD: Đang đào kim cương ở Y=-58..."
                            Text="{x:Bind ViewModel.DiscordStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ToggleSwitch
                            Header="Hiển thị tên instance và phiên bản Minecraft trên Discord"
                            IsOn="{x:Bind ViewModel.DiscordShowInstance, Mode=TwoWay}" />
                        <ToggleSwitch
                            Header="Gửi nhật ký crash ẩn danh giúp cải thiện V.A.Z"
                            IsOn="{x:Bind ViewModel.AnonymousTelemetry, Mode=TwoWay}" />

                        <StackPanel Spacing="8">
                            <TextBlock Text="XEM TRƯỚC TRÊN DISCORD" Style="{StaticResource CaptionTextBlockStyle}" />
                            <!-- Preview dựng theo .discord-profile-card của web: #2b2d31, radius 8,
                                 padding 14/16; art 60×60 + avatar 22×22 góc dưới-phải. -->
                            <Border
                                Background="#2B2D31"
                                BorderBrush="#0FFFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,14"
                                MaxWidth="420"
                                HorizontalAlignment="Left"
                                Opacity="{x:Bind ViewModel.DiscordPreviewOpacity, Mode=OneWay}">
                                <StackPanel Spacing="10">
                                    <TextBlock
                                        Text="ĐANG CHƠI MỘT TRÒ CHƠI"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="#B5BAC1"
                                        CharacterSpacing="44" />
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                        <Grid Width="60" Height="60" VerticalAlignment="Center">
                                            <Border Background="#1E1F22" CornerRadius="8">
                                                <Image
                                                    Source="{x:Bind ViewModel.DiscordPreviewLargeArt, Mode=OneWay}"
                                                    Stretch="UniformToFill" />
                                            </Border>
                                            <Border
                                                Width="22" Height="22"
                                                Background="#1E1F22"
                                                BorderBrush="#2B2D31"
                                                BorderThickness="2"
                                                CornerRadius="11"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,-4,-4">
                                                <Image
                                                    Source="{x:Bind ViewModel.DiscordPreviewSmallArt, Mode=OneWay}"
                                                    Stretch="UniformToFill" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Minecraft" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.DiscordPreviewInstance, Mode=OneWay}"
                                                FontSize="12.5" Foreground="#949BA4"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.DiscordPreviewStatus, Mode=OneWay}"
                                                FontSize="12.5" Foreground="#949BA4"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="00:42 elapsed" FontSize="12" Foreground="#949BA4" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 6. Lưu trữ & Dữ liệu -->
                <Border
                    Style="{StaticResource SettingsCardStyle}"
                    Visibility="{x:Bind ViewModel.SelectedCategoryKey, Mode=OneWay, Converter={StaticResource SettingsSectionVis}, ConverterParameter=storage}">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="20" Foreground="{StaticResource VazAccentBrush}" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Lưu trữ &amp; Dữ liệu" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <TextBlock Text="Vị trí lưu instance, sao lưu thế giới và bộ nhớ tạm." Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox
                                Header="Thư mục dữ liệu launcher"
                                IsReadOnly="True"
                                Text="{x:Bind ViewModel.DataPath, Mode=OneWay}" />
                            <Button Grid.Column="1" Content="Mở" VerticalAlignment="Bottom" Click="OpenDataFolder_Click" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox
                                Header="Thư mục sao lưu thế giới"
                                IsReadOnly="True"
                                Text="{x:Bind ViewModel.BackupPath, Mode=OneWay}" />
                            <Button Grid.Column="1" Content="Mở" VerticalAlignment="Bottom" Click="OpenBackupFolder_Click" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Dung lượng bộ nhớ tạm (Cache):" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.CacheSizeText, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Content="Xóa cache tải xuống"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Click="ClearCache_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 7. Thông tin & Chẩn đoán -->
                <Border
                    Style="{StaticResource SettingsCardStyle}"
                    Visibility="{x:Bind ViewModel.SelectedCategoryKey, Mode=OneWay, Converter={StaticResource SettingsSectionVis}, ConverterParameter=about}">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <FontIcon Glyph="&#xE946;" FontSize="20" Foreground="{StaticResource VazAccentBrush}" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Thông tin &amp; Chẩn đoán" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <TextBlock Text="Phiên bản, thông số phần cứng và xuất báo cáo lỗi." Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border
                                    Width="32" Height="32"
                                    Background="{StaticResource VazAccentBrush}"
                                    CornerRadius="7">
                                    <TextBlock Text="V" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="V.A.Z Minecraft Client" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.VersionLabel}" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Content="Kiểm tra cập nhật"
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.CheckForUpdatesCommand}" />
                        </Grid>

                        <Border
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16">
                            <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                                <TextBlock Text="Hệ điều hành:" Style="{StaticResource SpecLabelStyle}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.OsSpec, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Text="Vi xử lý (CPU):" Style="{StaticResource SpecLabelStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.CpuSpec, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2" Text="Đồ họa (GPU):" Style="{StaticResource SpecLabelStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.GpuSpec, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="3" Text="Bộ nhớ (RAM):" Style="{StaticResource SpecLabelStyle}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.RamSpec, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="4" Text="Java phát hiện:" Style="{StaticResource SpecLabelStyle}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.JavaSpec, Mode=OneWay}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <Button
                            Content="Xuất báo cáo chẩn đoán (.json)"
                            HorizontalAlignment="Left"
                            Click="ExportDiagnostic_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Status (SET-AC-06/08/09/10) -->
        <StackPanel Grid.Row="3" Spacing="8">
            <InfoBar
                Severity="Error"
                Title="Lỗi"
                IsOpen="{x:Bind ViewModel.HasError, Mode=TwoWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            <InfoBar
                Severity="Success"
                IsOpen="{x:Bind ViewModel.IsNotificationOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.NotificationText, Mode=OneWay}"
                IsClosable="True" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center" />
                <ProgressRing
                    Grid.Column="1"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Width="18" Height="18" />
            </Grid>
        </StackPanel>
    </Grid>
</Page>
