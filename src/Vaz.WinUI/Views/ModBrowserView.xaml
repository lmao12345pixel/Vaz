<UserControl
    x:Class="Vaz.WinUI.Views.ModBrowserView"
    x:Name="RootView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Vaz.WinUI.ViewModels"
    xmlns:views="using:Vaz.WinUI.Views"
    KeyDown="UserControl_KeyDown">

    <UserControl.Resources>
        <!-- Shimmer pulse animation -->
        <Storyboard x:Name="ShimmerStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation
                Storyboard.TargetName="ShimmerPanel"
                Storyboard.TargetProperty="Opacity"
                From="0.4"
                To="0.9"
                Duration="0:0:0.75" />
        </Storyboard>

        <!-- Search box cursor blink animation -->
        <Storyboard x:Name="BlinkCursorStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation
                Storyboard.TargetName="SearchBlinkIndicator"
                Storyboard.TargetProperty="Opacity"
                From="0.0"
                To="1.0"
                Duration="0:0:0.5" />
        </Storyboard>

        <!-- Results list transition animation -->
        <Storyboard x:Name="FadeInResultsStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="ResultsListView"
                Storyboard.TargetProperty="Opacity"
                From="0.2"
                To="1.0"
                Duration="0:0:0.25" />
        </Storyboard>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <!-- 1. Header: Back Button, Title & Subtitle, Close Button -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,0,0,4">
            <!-- Back Button -->
            <Button
                Grid.Column="0"
                Click="CloseButton_Click"
                Background="Transparent"
                BorderThickness="0"
                Padding="8"
                CornerRadius="8"
                VerticalAlignment="Center"
                ToolTipService.ToolTip="Quay lại chi tiết instance (Esc)">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>

            <!-- Title & Badges -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE896;" FontSize="18" Foreground="{StaticResource VazAccentBrush}" />
                    <TextBlock Text="Khám phá &amp; Tải Mods" FontSize="20" FontWeight="SemiBold" />
                    <Border
                        Background="{StaticResource VazAccentSubtleBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,2"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="Modrinth"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource VazAccentBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock
                    Text="Tìm kiếm và tải mods tương thích trực tiếp vào instance của bạn"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Close 'X' Button -->
            <Button
                Grid.Column="2"
                Click="CloseButton_Click"
                Background="Transparent"
                BorderThickness="0"
                Padding="8"
                CornerRadius="8"
                VerticalAlignment="Center"
                ToolTipService.ToolTip="Đóng (Esc)">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>

        <!-- 2. Search Bar with Blinking Cursor Effect -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <AutoSuggestBox
                Grid.Column="0"
                x:Name="SearchBox"
                PlaceholderText="Tìm mod trên Modrinth (ví dụ: sodium, iris, lithium)..."
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                TextChanged="SearchBox_TextChanged"
                QuerySubmitted="SearchBox_QuerySubmitted"
                GotFocus="SearchBox_GotFocus"
                LostFocus="SearchBox_LostFocus"
                HorizontalAlignment="Stretch" />

            <!-- Blinking indicator beside search box to highlight active search -->
            <Border
                Grid.Column="1"
                x:Name="SearchBlinkIndicator"
                Width="3"
                Height="20"
                Background="#10B981"
                CornerRadius="1.5"
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                Opacity="0" />
        </Grid>

        <!-- 3. Dynamic Filter Chips (Thanh ngang động) -->
        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Enabled"
            VerticalScrollMode="Disabled">
            <ItemsControl ItemsSource="{x:Bind ViewModel.FilterChips, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button
                            Content="{x:Bind}"
                            Click="FilterChip_Click"
                            CornerRadius="14"
                            Padding="12,4"
                            FontSize="12"
                            Style="{StaticResource DefaultButtonStyle}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 4. Horizontal Filter Row (Thanh lọc ngang) -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <ComboBox
                Header="Loader"
                ItemsSource="{x:Bind ViewModel.LoaderOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedLoader, Mode=TwoWay}"
                MinWidth="110" />
            <ComboBox
                Header="MC version"
                ItemsSource="{x:Bind ViewModel.VersionOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedGameVersion, Mode=TwoWay}"
                MinWidth="110" />
            <ComboBox
                Header="Sort"
                ItemsSource="{x:Bind ViewModel.SortOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}"
                MinWidth="120" />
            <CheckBox
                Content="Tải kèm dependencies"
                IsChecked="{x:Bind ViewModel.IncludeDependencies, Mode=TwoWay}"
                VerticalAlignment="Bottom"
                Margin="4,0,0,2" />
        </StackPanel>

        <!-- 5. Status / Error / Progress Bar -->
        <StackPanel Grid.Row="4" Spacing="6">
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=TwoWay}"
                Severity="Error"
                Title="Lỗi"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button
                        Content="Thử lại"
                        Command="{x:Bind ViewModel.RetryCommand}"
                        Padding="12,4" />
                </InfoBar.ActionButton>
            </InfoBar>
            <TextBlock
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
            <Grid Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <ProgressBar
                    Height="4"
                    Maximum="100"
                    IsIndeterminate="False"
                    Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                    VerticalAlignment="Center"
                    Margin="0,0,70,0" />
                <Button
                    Content="Hủy"
                    Command="{x:Bind ViewModel.CancelInstallCommand}"
                    HorizontalAlignment="Right"
                    Padding="12,2"
                    FontSize="12" />
            </Grid>
        </StackPanel>

        <!-- 6. Main Content Area (Shimmer Loading Skeleton OR Results ListView OR Empty State) -->
        <Grid Grid.Row="5">
            <!-- Shimmer Skeleton Loading State -->
            <StackPanel
                x:Name="ShimmerPanel"
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsShimmerLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                Padding="0,4">
                <!-- Skeleton Card 1 -->
                <Border
                    Padding="14"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="16">
                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="6" Background="{ThemeResource LayerFillColorDefaultBrush}" />
                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                            <Border Width="160" Height="16" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}" HorizontalAlignment="Left" />
                            <Border Width="100" Height="12" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}" HorizontalAlignment="Left" />
                            <Border Height="12" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}" Margin="0,2,40,0" />
                        </StackPanel>
                        <Border Grid.Column="2" Width="64" Height="32" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Skeleton Card 2 -->
                <Border
                    Padding="14"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="16">
                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="6" Background="{ThemeResource LayerFillColorDefaultBrush}" />
                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                            <Border Width="200" Height="16" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}" HorizontalAlignment="Left" />
                            <Border Width="120" Height="12" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}" HorizontalAlignment="Left" />
                            <Border Height="12" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}" Margin="0,2,60,0" />
                        </StackPanel>
                        <Border Grid.Column="2" Width="64" Height="32" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Skeleton Card 3 -->
                <Border
                    Padding="14"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="16">
                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="6" Background="{ThemeResource LayerFillColorDefaultBrush}" />
                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                            <Border Width="140" Height="16" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}" HorizontalAlignment="Left" />
                            <Border Width="90" Height="12" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}" HorizontalAlignment="Left" />
                            <Border Height="12" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}" Margin="0,2,30,0" />
                        </StackPanel>
                        <Border Grid.Column="2" Width="64" Height="32" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Results ListView with ModCard (DataTemplate độc lập) & VirtualizingStackPanel -->
            <ListView
                x:Name="ResultsListView"
                ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsShimmerLoading, Mode=OneWay, Converter={StaticResource BoolToVisInv}}"
                SelectionMode="None"
                Loaded="ResultsListView_Loaded"
                Padding="0,2">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SearchHitRow">
                        <views:ModCard
                            Item="{x:Bind}"
                            InstallClick="ModCard_InstallClick" />
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!-- Empty State -->
            <StackPanel
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <FontIcon Glyph="&#xE721;" FontSize="32" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                <TextBlock
                    Text="Không tìm thấy mod nào phù hợp"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                <TextBlock
                    Text="Thử kiểm tra từ khóa hoặc chọn bộ lọc khác"
                    FontSize="12"
                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>
        </Grid>

        <!-- 7. Bottom Infinite Scroll Spinner (Không dùng nút Load more) -->
        <Grid Grid.Row="6" HorizontalAlignment="Center" Margin="0,4,0,0">
            <ProgressRing
                Width="24"
                Height="24"
                IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- 8. Dependency confirmation prompt overlay (MM-AC-04) -->
        <Grid
            x:Name="DependencyPromptOverlay"
            Grid.RowSpan="7"
            Background="#88000000"
            Visibility="Collapsed"
            Margin="-24"
            Padding="24"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="480"
                CornerRadius="12"
                Padding="24"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE7BA;" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="20" />
                        <TextBlock Text="Cài đặt kèm dependencies?" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>

                    <TextBlock
                        x:Name="DependencyPromptText"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        Text="Mod này yêu cầu các thư viện dependencies để hoạt động. Bạn có muốn cài đặt kèm toàn bộ dependencies?" />

                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Hủy" Click="CancelDependencyPrompt_Click" Padding="14,6" />
                        <Button
                            x:Name="ConfirmDependencyPromptButton"
                            Style="{StaticResource VazAccentButtonStyle}"
                            Content="Cài kèm dependencies"
                            Click="ConfirmDependencyPrompt_Click"
                            Padding="14,6" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
