<UserControl
    x:Class="Vaz.WinUI.Views.ModBrowserView"
    x:Name="RootView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Vaz.WinUI.ViewModels"
    xmlns:views="using:Vaz.WinUI.Views"
    KeyDown="UserControl_KeyDown"
    PreviewKeyDown="UserControl_PreviewKeyDown">

    <UserControl.Resources>
        <!-- Shimmer pulse animation -->
        <Storyboard x:Name="ShimmerStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation
                Storyboard.TargetName="ShimmerPanel"
                Storyboard.TargetProperty="Opacity"
                From="0.4"
                To="0.9"
                Duration="0:0:0.75" />
        </Storyboard>

        <!-- Search box cursor blink animation -->
        <Storyboard x:Name="BlinkCursorStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation
                Storyboard.TargetName="SearchBlinkIndicator"
                Storyboard.TargetProperty="Opacity"
                From="0.0"
                To="1.0"
                Duration="0:0:0.5" />
        </Storyboard>

        <!-- Results list transition animation -->
        <Storyboard x:Name="FadeInResultsStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="ResultsListView"
                Storyboard.TargetProperty="Opacity"
                From="0.0"
                To="1.0"
                Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Filter chips entrance animation (150ms) -->
        <Storyboard x:Name="FilterChipsEntranceStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="FilterChipsScrollViewer"
                Storyboard.TargetProperty="Opacity"
                From="0.2"
                To="1.0"
                Duration="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="FilterChipsTranslate"
                Storyboard.TargetProperty="Y"
                From="6"
                To="0"
                Duration="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        Padding="24,16,24,20"
        RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">

        <!-- 0. Header Bar: Nút Quay lại, Tiêu đề, Badge Modrinth, Nút Đóng -->
        <Grid Grid.Row="0" Margin="0,0,0,16" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button
                    Click="Back_Click"
                    ToolTipService.ToolTip="Quay lại danh sách Instance"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8"
                    CornerRadius="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                </Button>
                <TextBlock
                    Text="{x:Bind ViewModel.BrowserTitle, Mode=OneWay}"
                    FontSize="20"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
                <Border
                    Background="#1810B981"
                    BorderBrush="#3010B981"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="6,2"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="Modrinth"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#10B981" />
                </Border>
            </StackPanel>

            <Button
                Grid.Column="2"
                Click="Close_Click"
                ToolTipService.ToolTip="Đóng trình duyệt mod (Esc)"
                Background="Transparent"
                BorderThickness="0"
                Padding="8"
                CornerRadius="8">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>

        <!-- 1. Search Bar with Blinking Cursor Effect -->
        <Grid Grid.Row="1" Margin="0,0,0,12" ColumnDefinitions="*,Auto">
            <AutoSuggestBox
                Grid.Column="0"
                x:Name="SearchBox"
                PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                PreviewKeyDown="SearchBox_PreviewKeyDown"
                TextChanged="SearchBox_TextChanged"
                QuerySubmitted="SearchBox_QuerySubmitted"
                GotFocus="SearchBox_GotFocus"
                LostFocus="SearchBox_LostFocus"
                HorizontalAlignment="Stretch" />

            <Border
                Grid.Column="1"
                x:Name="SearchBlinkIndicator"
                Width="3"
                Height="20"
                Background="#10B981"
                CornerRadius="1.5"
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                Opacity="0" />
        </Grid>

        <!-- 2. Dynamic Filter Chips (Thanh ngang động với Animation 150ms) -->
        <ScrollViewer
            x:Name="FilterChipsScrollViewer"
            Grid.Row="2"
            Margin="0,0,0,12"
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Enabled"
            VerticalScrollMode="Disabled">
            <ScrollViewer.RenderTransform>
                <TranslateTransform x:Name="FilterChipsTranslate" Y="0" />
            </ScrollViewer.RenderTransform>
            <ItemsControl ItemsSource="{x:Bind ViewModel.FilterChips, Mode=OneWay}">
                <ItemsControl.ItemContainerTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromHorizontalOffset="12" IsStaggeringEnabled="True" />
                        <AddDeleteThemeTransition />
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </ItemsControl.ItemContainerTransitions>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button
                            Content="{x:Bind}"
                            Click="FilterChip_Click"
                            CornerRadius="14"
                            Padding="12,4"
                            FontSize="12" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 3. Horizontal Filter Row (Thanh lọc ngang) -->
        <StackPanel Grid.Row="3" Margin="0,0,0,12" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <ComboBox
                Header="Loader"
                ItemsSource="{x:Bind ViewModel.LoaderOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedLoader, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.IsModProjectType, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                MinWidth="110" />
            <ComboBox
                Header="MC version"
                ItemsSource="{x:Bind ViewModel.VersionOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedGameVersion, Mode=TwoWay}"
                MinWidth="110" />
            <ComboBox
                Header="Sort"
                ItemsSource="{x:Bind ViewModel.SortOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}"
                MinWidth="120" />
            <CheckBox
                Content="Tải kèm dependencies"
                IsChecked="{x:Bind ViewModel.IncludeDependencies, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.IsModProjectType, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                VerticalAlignment="Bottom"
                Margin="4,0,0,2" />
        </StackPanel>

        <!-- 4. Status / Error / Progress Bar -->
        <StackPanel Grid.Row="4" Margin="0,0,0,8" Spacing="6">
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=TwoWay}"
                Severity="Error"
                Title="Lỗi"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button
                        Content="Thử lại"
                        Command="{x:Bind ViewModel.RetryCommand}"
                        Padding="12,4" />
                </InfoBar.ActionButton>
            </InfoBar>
            <TextBlock
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
            <Grid Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <ProgressBar
                    Height="4"
                    Maximum="100"
                    IsIndeterminate="False"
                    Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                    VerticalAlignment="Center"
                    Margin="0,0,70,0" />
                <Button
                    Content="Hủy"
                    Command="{x:Bind ViewModel.CancelInstallCommand}"
                    HorizontalAlignment="Right"
                    Padding="12,2"
                    FontSize="12" />
            </Grid>
        </StackPanel>

        <!-- 5. Main Content Area (Shimmer Loading Skeleton OR Results ListView OR Empty State) -->
        <Grid Grid.Row="5">
            <!-- Shimmer Skeleton Loading State -->
            <StackPanel
                x:Name="ShimmerPanel"
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsShimmerLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                Padding="0,4">
                <!-- Skeleton Card 1 -->
                <Border
                    Padding="14"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="16">
                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="6" Background="{ThemeResource LayerFillColorDefaultBrush}" />
                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                            <Border Width="160" Height="16" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}" HorizontalAlignment="Left" />
                            <Border Width="100" Height="12" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}" HorizontalAlignment="Left" />
                            <Border Height="12" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}" Margin="0,2,40,0" />
                        </StackPanel>
                        <Border Grid.Column="2" Width="64" Height="32" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Skeleton Card 2 -->
                <Border
                    Padding="14"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="16">
                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="6" Background="{ThemeResource LayerFillColorDefaultBrush}" />
                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                            <Border Width="200" Height="16" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}" HorizontalAlignment="Left" />
                            <Border Width="120" Height="12" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}" HorizontalAlignment="Left" />
                            <Border Height="12" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}" Margin="0,2,60,0" />
                        </StackPanel>
                        <Border Grid.Column="2" Width="64" Height="32" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Skeleton Card 3 -->
                <Border
                    Padding="14"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="16">
                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="6" Background="{ThemeResource LayerFillColorDefaultBrush}" />
                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                            <Border Width="140" Height="16" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}" HorizontalAlignment="Left" />
                            <Border Width="90" Height="12" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}" HorizontalAlignment="Left" />
                            <Border Height="12" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}" Margin="0,2,30,0" />
                        </StackPanel>
                        <Border Grid.Column="2" Width="64" Height="32" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Results ListView with Virtualized ItemsStackPanel, ModCard & Phased Loading -->
            <ListView
                x:Name="ResultsListView"
                ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsShimmerLoading, Mode=OneWay, Converter={StaticResource BoolToVisInv}}"
                SelectionMode="None"
                Loaded="ResultsListView_Loaded"
                ContainerContentChanging="ResultsListView_ContainerContentChanging"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollMode="Enabled"
                ScrollViewer.HorizontalScrollMode="Disabled"
                Padding="0,2">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel
                            Orientation="Vertical"
                            CacheLength="4.0" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SearchHitRow">
                        <views:ModCard
                            Item="{x:Bind}"
                            InstallClick="ModCard_InstallClick" />
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!-- Empty State -->
            <StackPanel
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <FontIcon Glyph="&#xE721;" FontSize="32" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                <TextBlock
                    Text="Không tìm thấy mod nào phù hợp"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                <TextBlock
                    Text="Thử kiểm tra từ khóa hoặc chọn bộ lọc khác"
                    FontSize="12"
                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>
        </Grid>

        <!-- 6. Bottom Infinite Scroll Spinner -->
        <Grid Grid.Row="6" HorizontalAlignment="Center" Margin="0,6,0,0">
            <ProgressRing
                Width="24"
                Height="24"
                IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- 7. Dependency confirmation prompt overlay -->
        <Grid
            x:Name="DependencyPromptOverlay"
            Grid.RowSpan="7"
            Background="#88000000"
            Visibility="Collapsed"
            Margin="-24,-16,-24,-20"
            Padding="24"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="480"
                CornerRadius="12"
                Padding="24"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE7BA;" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="20" />
                        <TextBlock Text="Cài đặt kèm dependencies?" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>

                    <TextBlock
                        x:Name="DependencyPromptText"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />

                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button
                            Content="Hủy"
                            Click="CancelDependencyPrompt_Click"
                            Padding="14,6" />
                        <Button
                            x:Name="ConfirmDependencyPromptButton"
                            Style="{StaticResource VazAccentButtonStyle}"
                            Content="Cài kèm dependencies"
                            Click="ConfirmDependencyPrompt_Click"
                            Padding="14,6" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
