<UserControl
    x:Class="Vaz.WinUI.Views.ModrinthCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Vaz.WinUI.ViewModels"
    x:Name="ModrinthCardRoot">

    <UserControl.Resources>
        <Storyboard x:Name="HoverEnterStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="CardScale"
                Storyboard.TargetProperty="ScaleX"
                To="1.02"
                Duration="0:0:0.200">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="CardScale"
                Storyboard.TargetProperty="ScaleY"
                To="1.02"
                Duration="0:0:0.200">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="HoverBorder"
                Storyboard.TargetProperty="Opacity"
                To="1.0"
                Duration="0:0:0.200" />
        </Storyboard>

        <Storyboard x:Name="HoverExitStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="CardScale"
                Storyboard.TargetProperty="ScaleX"
                To="1.0"
                Duration="0:0:0.200">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="CardScale"
                Storyboard.TargetProperty="ScaleY"
                To="1.0"
                Duration="0:0:0.200">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="HoverBorder"
                Storyboard.TargetProperty="Opacity"
                To="0.0"
                Duration="0:0:0.200" />
        </Storyboard>
    </UserControl.Resources>

    <Grid
        Margin="0"
        RenderTransformOrigin="0.5,0.5"
        PointerEntered="Card_PointerEntered"
        PointerExited="Card_PointerExited">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="CardScale" ScaleX="1.0" ScaleY="1.0" />
        </Grid.RenderTransform>

        <!-- Base Background & Border (Nền xám đen #262626, bo góc 8px) -->
        <Border
            Background="#262626"
            BorderBrush="#383838"
            BorderThickness="1"
            CornerRadius="8" />

        <!-- Accent Border on Hover (#1bd96a) -->
        <Border
            x:Name="HoverBorder"
            BorderBrush="#1bd96a"
            BorderThickness="1.5"
            CornerRadius="8"
            Opacity="0"
            IsHitTestVisible="False" />

        <Grid Padding="0">
            <Grid.RowDefinitions>
                <!-- 16:9 Cover Thumbnail -->
                <RowDefinition Height="150" />
                <!-- Content Area -->
                <RowDefinition Height="*" />
                <!-- Footer -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Cover Image Container (16:9, bo góc trên) -->
            <Grid Grid.Row="0" CornerRadius="8,8,0,0">
                <Border Background="#1c1c1c" CornerRadius="8,8,0,0">
                    <Image
                        x:Name="CoverImage"
                        Stretch="UniformToFill"
                        ImageFailed="CoverImage_Failed" />
                </Border>

                <!-- Tag Overlay (Featured / Popular) -->
                <Border
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="10"
                    Padding="8,3"
                    Background="#cc1a1a1a"
                    BorderBrush="#1bd96a"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{x:Bind Item.OverlayTagVisibility, Mode=OneWay}">
                    <TextBlock
                        Text="{x:Bind Item.OverlayTag, Mode=OneWay}"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#1bd96a" />
                </Border>
            </Grid>

            <!-- 2. Card Content Body (Padding 12px) -->
            <StackPanel Grid.Row="1" Padding="12,10,12,6" Spacing="4">
                <!-- Tên Project (Trắng, In đậm, 16px) + Tên tác giả (Xám nhạt, 13px) nằm cùng hàng -->
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Text="{x:Bind Item.Title, Mode=OneWay}"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#ffffff"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="1" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind Item.AuthorText, Mode=OneWay}"
                        FontSize="13"
                        Foreground="#9e9e9e"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0" />
                </Grid>

                <!-- Mô tả ngắn (Xám, 14px, cắt dòng bằng TextTrimming="CharacterEllipsis", tối đa 2 dòng) -->
                <TextBlock
                    Text="{x:Bind Item.Description, Mode=OneWay}"
                    FontSize="14"
                    Foreground="#b0b0b0"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="2"
                    TextWrapping="Wrap"
                    Height="38" />

                <!-- Tags (Pill shape): Nền #404040, chữ trắng #cccccc, bo tròn hoàn toàn CornerRadius=10 -->
                <ItemsControl ItemsSource="{x:Bind Item.DisplayTags, Mode=OneWay}" Margin="0,4,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border
                                Background="#404040"
                                CornerRadius="10"
                                Padding="8,2"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind}"
                                    FontSize="11"
                                    Foreground="#cccccc"
                                    FontWeight="Medium" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 3. Footer (Hàng dưới cùng): Downloads, Likes/Follows, UpdatedAt, Action -->
            <Grid Grid.Row="2" Padding="12,6,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Footer Stats Group -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <!-- Icon Download + Số lượt tải -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="#9e9e9e" />
                        <TextBlock
                            Text="{x:Bind Item.DownloadsText, Mode=OneWay}"
                            FontSize="12"
                            Foreground="#9e9e9e" />
                    </StackPanel>

                    <!-- Icon Heart + Số lượt thích -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xEB52;" FontSize="12" Foreground="#9e9e9e" />
                        <TextBlock
                            Text="{x:Bind Item.FollowsText, Mode=OneWay}"
                            FontSize="12"
                            Foreground="#9e9e9e" />
                    </StackPanel>

                    <!-- Icon Clock + Thời gian cập nhật -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE823;" FontSize="12" Foreground="#9e9e9e" />
                        <TextBlock
                            Text="{x:Bind Item.UpdatedAtText, Mode=OneWay}"
                            FontSize="12"
                            Foreground="#9e9e9e" />
                    </StackPanel>
                </StackPanel>

                <!-- Install Action / State -->
                <Grid Grid.Column="1">
                    <!-- Idle Install Button -->
                    <Button
                        x:Name="IdleButton"
                        Click="InstallButton_Click"
                        Background="#333333"
                        BorderBrush="#1bd96a"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,4"
                        ToolTipService.ToolTip="Cài đặt">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE896;" FontSize="11" Foreground="#1bd96a" />
                            <TextBlock Text="Cài đặt" FontSize="11" FontWeight="SemiBold" Foreground="#1bd96a" />
                        </StackPanel>
                    </Button>

                    <!-- Installing State -->
                    <StackPanel
                        x:Name="InstallingPanel"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <ProgressRing
                            x:Name="InstallingRing"
                            Width="14"
                            Height="14"
                            IsActive="False"
                            Foreground="#1bd96a" />
                        <TextBlock Text="Đang tải..." FontSize="11" Foreground="#1bd96a" />
                    </StackPanel>

                    <!-- Installed State Badge -->
                    <Border
                        x:Name="InstalledBadge"
                        Background="#1b3826"
                        BorderBrush="#1bd96a"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="6,3"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="#1bd96a" />
                            <TextBlock Text="Đã cài" FontSize="11" FontWeight="SemiBold" Foreground="#1bd96a" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
