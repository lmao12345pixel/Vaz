<UserControl
    x:Class="Vaz.WinUI.Views.ModrinthCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Vaz.WinUI.ViewModels"
    x:Name="ModrinthCardRoot">

    <UserControl.Resources>
        <Storyboard x:Name="HoverEnterStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="CardScale"
                Storyboard.TargetProperty="ScaleX"
                To="1.02"
                Duration="0:0:0.200">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="CardScale"
                Storyboard.TargetProperty="ScaleY"
                To="1.02"
                Duration="0:0:0.200">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="HoverBorder"
                Storyboard.TargetProperty="Opacity"
                To="1.0"
                Duration="0:0:0.200" />
        </Storyboard>

        <Storyboard x:Name="HoverExitStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="CardScale"
                Storyboard.TargetProperty="ScaleX"
                To="1.0"
                Duration="0:0:0.200">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="CardScale"
                Storyboard.TargetProperty="ScaleY"
                To="1.0"
                Duration="0:0:0.200">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="HoverBorder"
                Storyboard.TargetProperty="Opacity"
                To="0.0"
                Duration="0:0:0.200" />
        </Storyboard>
    </UserControl.Resources>

    <Grid
        Margin="0"
        RenderTransformOrigin="0.5,0.5"
        PointerEntered="Card_PointerEntered"
        PointerExited="Card_PointerExited">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="CardScale" ScaleX="1.0" ScaleY="1.0" />
        </Grid.RenderTransform>

        <!-- Base Background & Border -->
        <Border
            Background="#181a1f"
            BorderBrush="#2a2e38"
            BorderThickness="1"
            CornerRadius="8" />

        <!-- Accent Border on Hover -->
        <Border
            x:Name="HoverBorder"
            BorderBrush="#1bd96a"
            BorderThickness="1.5"
            CornerRadius="8"
            Opacity="0"
            IsHitTestVisible="False" />

        <Grid Padding="0">
            <Grid.RowDefinitions>
                <!-- 16:9 Cover Thumbnail -->
                <RowDefinition Height="140" />
                <!-- Content Area -->
                <RowDefinition Height="*" />
                <!-- Footer -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cover Image Container -->
            <Grid Grid.Row="0" CornerRadius="8,8,0,0">
                <Border Background="#121316" CornerRadius="8,8,0,0">
                    <Image
                        x:Name="CoverImage"
                        Stretch="UniformToFill"
                        ImageFailed="CoverImage_Failed" />
                </Border>

                <!-- Tag Overlay (Featured / Popular) -->
                <Border
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="10"
                    Padding="8,3"
                    Background="#cc121316"
                    BorderBrush="#1bd96a"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{x:Bind Item.OverlayTagVisibility, Mode=OneWay}">
                    <TextBlock
                        Text="{x:Bind Item.OverlayTag, Mode=OneWay}"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#1bd96a" />
                </Border>
            </Grid>

            <!-- Card Content Body -->
            <StackPanel Grid.Row="1" Padding="12,10,12,6" Spacing="4">
                <!-- Title -->
                <TextBlock
                    Text="{x:Bind Item.Title, Mode=OneWay}"
                    FontSize="15"
                    FontWeight="Bold"
                    Foreground="#ffffff"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="1" />

                <!-- Author -->
                <TextBlock
                    Text="{x:Bind Item.Author, Mode=OneWay}"
                    FontSize="12"
                    Foreground="#8b949e"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="1" />

                <!-- Description -->
                <TextBlock
                    Text="{x:Bind Item.Description, Mode=OneWay}"
                    FontSize="12"
                    Foreground="#c9d1d9"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="2"
                    TextWrapping="Wrap"
                    Height="34" />

                <!-- Badge row -->
                <Border
                    Background="#1f232b"
                    CornerRadius="4"
                    Padding="6,3"
                    HorizontalAlignment="Left"
                    Margin="0,2,0,0">
                    <TextBlock
                        Text="{x:Bind Item.BadgeText, Mode=OneWay}"
                        FontSize="11"
                        Foreground="#9ba1b0"
                        TextTrimming="CharacterEllipsis" />
                </Border>
            </StackPanel>

            <!-- Card Footer -->
            <Grid Grid.Row="2" Padding="12,6,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Downloads -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                    <FontIcon Glyph="&#xE896;" FontSize="13" Foreground="#8b949e" />
                    <TextBlock
                        Text="{x:Bind Item.DownloadsText, Mode=OneWay}"
                        FontSize="12"
                        Foreground="#8b949e"
                        FontWeight="Medium" />
                </StackPanel>

                <!-- Install Action / State -->
                <Grid Grid.Column="1">
                    <!-- Idle Install Button -->
                    <Button
                        x:Name="IdleButton"
                        Click="InstallButton_Click"
                        Background="#1f232b"
                        BorderBrush="#1bd96a"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="#1bd96a" />
                            <TextBlock Text="Cài đặt" FontSize="12" FontWeight="SemiBold" Foreground="#1bd96a" />
                        </StackPanel>
                    </Button>

                    <!-- Installing State -->
                    <StackPanel
                        x:Name="InstallingPanel"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <ProgressRing
                            x:Name="InstallingRing"
                            Width="16"
                            Height="16"
                            IsActive="False"
                            Foreground="#1bd96a" />
                        <TextBlock Text="Đang tải..." FontSize="12" Foreground="#1bd96a" />
                    </StackPanel>

                    <!-- Installed State Badge -->
                    <Border
                        x:Name="InstalledBadge"
                        Background="#1b3826"
                        BorderBrush="#1bd96a"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,4"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="#1bd96a" />
                            <TextBlock Text="Đã cài" FontSize="11" FontWeight="SemiBold" Foreground="#1bd96a" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
