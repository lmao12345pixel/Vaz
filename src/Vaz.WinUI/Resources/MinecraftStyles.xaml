<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Đợt 21 — Minecraft Vibe styles. Mọi màu lấy qua {ThemeResource MkVibe...}. -->

    <!-- Panel kiểu block: viền đất dày, góc vuông -->
    <Style x:Key="MkVibePanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource MkVibeSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MkVibeDirtBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource MkVibeBlockThickness}" />
        <Setter Property="CornerRadius" Value="{ThemeResource MkVibeBlockCorner}" />
    </Style>

    <!-- Thẻ / card: nền đá, viền stone, không bo góc -->
    <Style x:Key="MkVibeCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource MkVibeBlockBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MkVibeStoneBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource MkVibeBlockThickness}" />
        <Setter Property="CornerRadius" Value="{ThemeResource MkVibeBlockCorner}" />
    </Style>

    <!-- Tiêu đề pixel (font fallback + đậm) -->
    <Style x:Key="MkVibeTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource MkVibePixelFont}" />
        <Setter Property="FontSize" Value="{ThemeResource MkVibeTitleSize}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource MkVibeTextBrush}" />
        <Setter Property="CharacterSpacing" Value="20" />
    </Style>

    <!-- Nhãn phụ / breadcrumb -->
    <Style x:Key="MkVibeLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource MkVibePixelFont}" />
        <Setter Property="FontSize" Value="{ThemeResource MkVibeLabelSize}" />
        <Setter Property="Foreground" Value="{ThemeResource MkVibeMutedTextBrush}" />
    </Style>

    <!-- Badge "Đã cài" / "Đang chạy" -->
    <Style x:Key="MkVibeBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource MkVibeEmeraldBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{ThemeResource MkVibeBlockCorner}" />
        <Setter Property="Padding" Value="6,2" />
    </Style>

    <!-- Nút chính: viền block 3px, không bo góc -->
    <Style x:Key="MkVibePrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource MkVibeEmeraldBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MkVibeDirtBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource MkVibeBlockThickness}" />
        <Setter Property="CornerRadius" Value="{ThemeResource MkVibeBlockCorner}" />
        <Setter Property="FontFamily" Value="{ThemeResource MkVibePixelFont}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Thanh "lò nung" (loading) — dùng cho ProgressBar -->
    <Style x:Key="MkVibeFurnaceProgressStyle" TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{ThemeResource MkVibeFurnaceBrush}" />
        <Setter Property="Background" Value="{ThemeResource MkVibeStoneBrush}" />
        <Setter Property="CornerRadius" Value="{ThemeResource MkVibeBlockCorner}" />
    </Style>

    <!-- Enchantment glint: overlay mỏng phủ lên card đã chọn -->
    <Style x:Key="MkVibeGlintStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource MkVibeGlintBrush}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="CornerRadius" Value="{ThemeResource MkVibeBlockCorner}" />
    </Style>
</ResourceDictionary>
