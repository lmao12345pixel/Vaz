<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Đợt 21 — Minecraft Vibe design tokens.
      * Key prefix MkVibe* để KHÔNG đè các key Minecraft* / Vaz* đã có trong App.xaml.
      * Màu chỉ nằm ở resource definition; mọi nơi sử dụng phải dùng {ThemeResource MkVibe...}.
      * ThemeDictionaries cung cấp biến thể Light / Dark / Default (fallback = Dark).
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="MkVibeEmeraldBrush" Color="#0E9F6E" />
            <SolidColorBrush x:Key="MkVibeDiamondBrush" Color="#0E9490" />
            <SolidColorBrush x:Key="MkVibeGoldBrush" Color="#B45309" />
            <SolidColorBrush x:Key="MkVibeDirtBrush" Color="#8B5A2B" />
            <SolidColorBrush x:Key="MkVibeStoneBrush" Color="#6B7280" />
            <SolidColorBrush x:Key="MkVibeSurfaceBrush" Color="#F5F0E6" />
            <SolidColorBrush x:Key="MkVibeBlockBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MkVibeTextBrush" Color="#1A1D23" />
            <SolidColorBrush x:Key="MkVibeMutedTextBrush" Color="#4B5563" />
            <SolidColorBrush x:Key="MkVibeGlintBrush" Color="#3310B981" />
            <SolidColorBrush x:Key="MkVibeFurnaceBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="MkVibePixelBorderBrush" Color="#000000" />
            <SolidColorBrush x:Key="MkVibeSlotHighlightBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="MkVibeSlotSubtleBorderBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="MkVibeWoodCardBorderBrush" Color="#4A3018" />
            <SolidColorBrush x:Key="MkVibeOverlayDimBrush" Color="#99000000" />
            <SolidColorBrush x:Key="MkVibeInputFloatingLabelBrush" Color="#E0FFFFFF" />

            <Color x:Key="MkVibeLoaderVanillaTopColor">#5D9C3A</Color>
            <Color x:Key="MkVibeLoaderVanillaBottomColor">#8B5A2B</Color>
            <Color x:Key="MkVibeLoaderFabricTopColor">#E8B84B</Color>
            <Color x:Key="MkVibeLoaderFabricBottomColor">#D4A43A</Color>
            <Color x:Key="MkVibeLoaderQuiltTopColor">#7B68EE</Color>
            <Color x:Key="MkVibeLoaderQuiltBottomColor">#9370DB</Color>
            <Color x:Key="MkVibeLoaderNeoForgeTopColor">#DC2626</Color>
            <Color x:Key="MkVibeLoaderNeoForgeBottomColor">#8B0000</Color>
            <Color x:Key="MkVibeLoaderForgeTopColor">#4A4A4A</Color>
            <Color x:Key="MkVibeLoaderForgeBottomColor">#2A2A2A</Color>

            <Color x:Key="MkVibeCreateGradientStartColor">#22C55E</Color>
            <Color x:Key="MkVibeCreateGradientMidColor">#10B981</Color>
            <Color x:Key="MkVibeCreateGradientEndColor">#06D6A0</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
