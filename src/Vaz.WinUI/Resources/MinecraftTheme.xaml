<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Đợt 21 — Minecraft Vibe design tokens.
      * Key prefix MkVibe* để KHÔNG đè các key Minecraft* / Vaz* đã có trong App.xaml.
      * Màu chỉ nằm ở resource definition; mọi nơi sử dụng phải dùng {ThemeResource MkVibe...}.
      * ThemeDictionaries cung cấp biến thể Light / Dark / Default (fallback = Dark).
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="MkVibeEmeraldBrush" Color="#0E9F6E" />
            <SolidColorBrush x:Key="MkVibeDiamondBrush" Color="#0E9490" />
            <SolidColorBrush x:Key="MkVibeGoldBrush" Color="#B45309" />
            <SolidColorBrush x:Key="MkVibeDirtBrush" Color="#8B5A2B" />
            <SolidColorBrush x:Key="MkVibeStoneBrush" Color="#6B7280" />
            <SolidColorBrush x:Key="MkVibeSurfaceBrush" Color="#F5F0E6" />
            <SolidColorBrush x:Key="MkVibeBlockBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MkVibeTextBrush" Color="#1A1D23" />
            <SolidColorBrush x:Key="MkVibeMutedTextBrush" Color="#4B5563" />
            <SolidColorBrush x:Key="MkVibeGlintBrush" Color="#3310B981" />
            <SolidColorBrush x:Key="MkVibeFurnaceBrush" Color="#F59E0B" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="MkVibeEmeraldBrush" Color="#10B981" />
            <SolidColorBrush x:Key="MkVibeDiamondBrush" Color="#4AEDD9" />
            <SolidColorBrush x:Key="MkVibeGoldBrush" Color="#FBBF24" />
            <SolidColorBrush x:Key="MkVibeDirtBrush" Color="#8B5A2B" />
            <SolidColorBrush x:Key="MkVibeStoneBrush" Color="#6B7280" />
            <SolidColorBrush x:Key="MkVibeSurfaceBrush" Color="#1A1D23" />
            <SolidColorBrush x:Key="MkVibeBlockBrush" Color="#242A33" />
            <SolidColorBrush x:Key="MkVibeTextBrush" Color="#F3F4F6" />
            <SolidColorBrush x:Key="MkVibeMutedTextBrush" Color="#9CA3AF" />
            <SolidColorBrush x:Key="MkVibeGlintBrush" Color="#334AEDD9" />
            <SolidColorBrush x:Key="MkVibeFurnaceBrush" Color="#F59E0B" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="MkVibeEmeraldBrush" Color="#10B981" />
            <SolidColorBrush x:Key="MkVibeDiamondBrush" Color="#4AEDD9" />
            <SolidColorBrush x:Key="MkVibeGoldBrush" Color="#FBBF24" />
            <SolidColorBrush x:Key="MkVibeDirtBrush" Color="#8B5A2B" />
            <SolidColorBrush x:Key="MkVibeStoneBrush" Color="#6B7280" />
            <SolidColorBrush x:Key="MkVibeSurfaceBrush" Color="#1A1D23" />
            <SolidColorBrush x:Key="MkVibeBlockBrush" Color="#242A33" />
            <SolidColorBrush x:Key="MkVibeTextBrush" Color="#F3F4F6" />
            <SolidColorBrush x:Key="MkVibeMutedTextBrush" Color="#9CA3AF" />
            <SolidColorBrush x:Key="MkVibeGlintBrush" Color="#334AEDD9" />
            <SolidColorBrush x:Key="MkVibeFurnaceBrush" Color="#F59E0B" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Font: chưa có Minecraftia.ttf trong repo → fallback Segoe UI (không thêm asset).
         Khi có font, chỉ đổi giá trị resource này, mọi control tự cập nhật. -->
    <FontFamily x:Key="MkVibePixelFont">Segoe UI</FontFamily>

    <!-- Block geometry tokens -->
    <x:Double x:Key="MkVibeBlockBorder">3</x:Double>
    <Thickness x:Key="MkVibeBlockThickness">3</Thickness>
    <CornerRadius x:Key="MkVibeBlockCorner">0</CornerRadius>
    <x:Double x:Key="MkVibeTitleSize">26</x:Double>
    <x:Double x:Key="MkVibeLabelSize">12</x:Double>
</ResourceDictionary>
