<Application
    x:Class="Vaz.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Vaz.WinUI.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Bắt buộc: nạp default styles/theme resources của WinUI 3.
                     Thiếu dictionary này → XamlParseException "Cannot find a Resource with the Name/Key ..." khi parse control đầu tiên. -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
            <helpers:InverseBoolToVisibilityConverter x:Key="BoolToVisInv" />
            <helpers:CountToBoolConverter x:Key="CountToBool" />
            <helpers:CountToTextConverter x:Key="CountToText" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
