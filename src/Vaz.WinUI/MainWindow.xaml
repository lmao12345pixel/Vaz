<Window
    x:Class="Vaz.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Vaz.WinUI.Views"
    Title="Vazer Launcher">

    <NavigationView
        x:Name="NavView"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="Left"
        OpenPaneLength="220"
        SelectionChanged="NavView_SelectionChanged">

        <NavigationView.PaneHeader>
            <ComboBox
                x:Name="InstanceCombo"
                MinWidth="180"
                MaxWidth="200"
                HorizontalAlignment="Stretch"
                Header="Instance"
                DisplayMemberPath="Name"
                ItemsSource="{x:Bind Picker.Instances}"
                SelectionChanged="InstanceCombo_SelectionChanged" />
        </NavigationView.PaneHeader>

        <NavigationView.MenuItems>
            <NavigationViewItem Content="Mod Browser" Tag="modbrowser" IsSelected="True">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE71E;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Instances" Tag="instances">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE7F8;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Accounts" Tag="accounts">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE77B;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
